<ui:FluentWindow x:Class="EduAnalytics.UI.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
        xmlns:views="clr-namespace:EduAnalytics.UI.Views"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="EduAnalytics"
        Icon="Assets/AppIcon.ico"
        MinHeight="720" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarBrandTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SidebarActiveTextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarSectionTitleCollapsibleStyle" TargetType="TextBlock" BasedOn="{StaticResource SidebarSectionTitleStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarInlineChevronStyle" TargetType="mi:MaterialIcon">
            <Setter Property="Kind" Value="ChevronDown"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsSectionExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Kind" Value="ChevronRight"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarSettingsContentStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsSectionExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamCalendarViewModel}">
            <views:ExamCalendarView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamAnalysisViewModel}">
            <views:ExamAnalysisView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnswerEntryViewModel}">
            <views:AnswerEntryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuestionBankViewModel}">
            <views:QuestionBankView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LearningOutcomeManagementViewModel}">
            <views:LearningOutcomeManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramOutcomeManagementViewModel}">
            <views:ProgramOutcomeManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramOutcomeReportViewModel}">
            <views:ProgramOutcomeReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuestionGroupEditorViewModel}">
            <views:QuestionGroupEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamFromBankViewModel}">
            <views:ExamFromBankView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamManagementViewModel}">
            <views:ExamManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SingleQuestionCreateViewModel}">
            <views:SingleQuestionCreateView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramOutcomeMappingViewModel}">
            <views:ProgramOutcomeMappingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentManagementViewModel}">
            <views:StudentManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcademicStructureViewModel}">
            <views:AcademicStructureView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OpticalReadingViewModel}">
            <views:OpticalReadingView/>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateToDashboardCommand}"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateToExamManagementCommand}"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateToQuestionBankCommand}"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateToStudentsCommand}"/>
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding NavigateToLearningOutcomesCommand}"/>
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding NavigateToProgramOutcomesCommand}"/>
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding NavigateToCalendarCommand}"/>
        <KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding AIAssistant.TogglePanelCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ TITLE BAR ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource TopBarBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="ToggleSidebar_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Menüyü Aç/Kapa"
                            Margin="-14,0,4,0">
                        <mi:MaterialIcon Kind="Menu" Width="14" Height="14"/>
                    </Button>
                    <mi:MaterialIcon Kind="SchoolOutline" Width="18" Height="18"
                                     Foreground="{DynamicResource PrimaryBrush}"
                                     VerticalAlignment="Center"/>
                    <TextBlock Text="EduAnalytics"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Ölçme değerlendirme paneli"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleBtn"
                            Click="ToggleTheme_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Tema: Açık">
                        <mi:MaterialIcon x:Name="ThemeIcon" Kind="WeatherSunny" Width="14" Height="14"/>
                    </Button>
                    <ToggleButton x:Name="UserMenuToggle"
                                  Width="44" Height="40"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  ToolTip="Hesap">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="{TemplateBinding Background}">
                                    <Border Width="26" Height="26"
                                            CornerRadius="{DynamicResource RadiusFull}"
                                            Background="{DynamicResource PrimaryBrush}">
                                        <Grid>
                                            <Image Source="{Binding CurrentUserPhoto, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding HasCurrentUserPhoto, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="13,13" RadiusX="13" RadiusY="13"/>
                                                </Image.Clip>
                                            </Image>
                                            <mi:MaterialIcon Kind="AccountOutline"
                                                             Width="15"
                                                             Height="15"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Visibility="{Binding HasCurrentUserPhoto, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                        </Grid>
                                    </Border>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=UserMenuToggle}"
                           StaysOpen="False"
                           PlacementTarget="{Binding ElementName=UserMenuToggle}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           HorizontalOffset="-180" VerticalOffset="4">
                        <Border Width="240"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusLg}"
                                Effect="{DynamicResource ShadowLg}">
                            <StackPanel Margin="6">
                                <Border Padding="12,10" CornerRadius="{DynamicResource RadiusMd}">
                                    <StackPanel>
                                        <TextBlock x:Name="UserMenuNameText"
                                                   Text="EduAnalytics"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Yerel kullanıcı"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="6,4"/>
                                <Button Click="ShowShortcuts_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,9">
                                    <StackPanel Orientation="Horizontal">
                                        <mi:MaterialIcon Kind="KeyboardOutline" Width="16" Height="16"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         VerticalAlignment="Center"/>
                                        <TextBlock Text="Klavye Kısayolları"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OpenUserSettings_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,9">
                                    <StackPanel Orientation="Horizontal">
                                        <mi:MaterialIcon Kind="AccountCogOutline" Width="16" Height="16"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         VerticalAlignment="Center"/>
                                        <TextBlock Text="Kullanıcı Ayarları"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="ToggleTheme_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,9">
                                    <StackPanel Orientation="Horizontal">
                                        <mi:MaterialIcon Kind="ThemeLightDark" Width="16" Height="16"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         VerticalAlignment="Center"/>
                                        <TextBlock Text="Temayı Değiştir"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Border Height="1"
                                        Background="{DynamicResource BorderSubtleBrush}"
                                        Margin="6,6"/>
                                <Button Click="Logout_Click"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,9">
                                    <StackPanel Orientation="Horizontal">
                                        <mi:MaterialIcon Kind="LogoutVariant" Width="16" Height="16"
                                                         Foreground="{DynamicResource DangerBrush}"
                                                         VerticalAlignment="Center"/>
                                        <TextBlock Text="Hesaptan Çıkış Yap"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Click="MinimizeWindow"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Küçült">
                        <mi:MaterialIcon Kind="WindowMinimize" Width="14" Height="14"/>
                    </Button>
                    <Button Click="ToggleMaximizeWindow"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Büyüt / Küçült">
                        <mi:MaterialIcon Kind="WindowMaximize" Width="14" Height="14"/>
                    </Button>
                    <Button Click="CloseWindow"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            ToolTip="Kapat">
                        <mi:MaterialIcon Kind="WindowClose" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ BODY ═══ -->
        <Grid Grid.Row="1" Background="{DynamicResource PageBgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="AIPanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

        <!-- ═══ SOL MENÜ ═══ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="24,22,20,10">
                    <StackPanel Orientation="Horizontal"
                                TextElement.Foreground="{DynamicResource SidebarActiveTextBrush}">
                        <mi:MaterialIcon Kind="SchoolOutline"
                                         Width="24"
                                         Height="24"
                                         Foreground="{DynamicResource SidebarIconActiveBrush}"
                                         VerticalAlignment="Center"/>
                        <TextBlock Text="EduAnalytics" Style="{StaticResource SidebarBrandTextStyle}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel TextElement.Foreground="{DynamicResource SidebarTextBrush}">
                        <!-- GENEL -->
                        <TextBlock Text="GENEL" Style="{StaticResource SidebarSectionTitleCollapsibleStyle}"/>

                        <Button Tag="Dashboard"
                                Command="{Binding NavigateToDashboardCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Dashboard (Ctrl+1)">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="ViewDashboardOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="Calendar"
                                Command="{Binding NavigateToCalendarCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Takvim (Ctrl+7)">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="CalendarClock" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Takvim" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="AcademicStructure"
                                Command="{Binding NavigateToAcademicStructureCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Akademik Yapı">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="BookOpenPageVariantOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Akademik Yapı" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <!-- SORU YÖNETİMİ -->
                        <TextBlock Text="SORU YÖNETİMİ" Style="{StaticResource SidebarSectionTitleCollapsibleStyle}"/>

                        <Button Tag="QuestionBank"
                                Command="{Binding NavigateToQuestionBankCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Soru Bankası (Ctrl+3)">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="FileSearchOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Soru Bankası" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="ExamFromBank"
                                Command="{Binding NavigateToExamFromBankCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Sınav Oluştur">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="FilePlusOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Sınav Oluştur" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="ExamManagement"
                                Command="{Binding NavigateToExamManagementCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Sınav Yönetimi (Ctrl+2)">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="FileDocumentEditOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Sınav Yönetimi" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="OptikOkuma"
                                Command="{Binding NavigateToOpticalReadingCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Optik Okuma — taranmış cevap formlarını otomatik oku">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="Scanner" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Optik Okuma" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <!-- ÇIKTI YÖNETİMİ -->
                        <TextBlock Text="ÇIKTI YÖNETİMİ" Style="{StaticResource SidebarSectionTitleCollapsibleStyle}"/>

                        <Button Tag="LearningOutcomes"
                                Command="{Binding NavigateToLearningOutcomesCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Öğrenim Çıktıları (Ctrl+5)">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="BookEducationOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Öğrenim Çıktıları" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="ProgramOutcomes"
                                Command="{Binding NavigateToProgramOutcomesCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Program Çıktıları (Ctrl+6)">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="ChartBar" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Program Çıktıları" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="ProgramOutcomeMapping"
                                Command="{Binding NavigateToProgramOutcomeMappingCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="PÇ - ÖÇ Eşleştirme">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="LinkVariant" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="PÇ - ÖÇ Eşleştirme" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="ProgramOutcomeReport"
                                Command="{Binding NavigateToProgramOutcomeReportCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="PÇ Başarı Raporu">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="ChartLineVariant" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="PÇ Başarı Raporu" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <!-- ÖĞRENCİ YÖNETİMİ -->
                        <TextBlock Text="ÖĞRENCİ YÖNETİMİ" Style="{StaticResource SidebarSectionTitleCollapsibleStyle}"/>

                        <Button Tag="Students"
                                Command="{Binding NavigateToStudentsCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Öğrenciler (Ctrl+4)">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="AccountMultipleOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Öğrenciler" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <Border Height="20"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource SidebarBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,0,0,24">
                    <StackPanel TextElement.Foreground="{DynamicResource SidebarTextBrush}">
                        <Button Click="ToggleSettingsSection_Click"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="Ayarları Aç/Kapa">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <mi:MaterialIcon Kind="CogOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="AYARLAR"
                                           Style="{StaticResource SidebarLabelStyle}"
                                           Foreground="{DynamicResource SidebarMutedBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"/>
                                <mi:MaterialIcon Grid.Column="2"
                                                 Style="{StaticResource SidebarInlineChevronStyle}"/>
                            </Grid>
                        </Button>

                        <StackPanel Style="{StaticResource SidebarSettingsContentStyle}">
                            <Button Click="OpenAISettings_Click"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    ToolTip="Yapay Zeka Ayarları">
                                <StackPanel Orientation="Horizontal">
                                    <mi:MaterialIcon Kind="Memory" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yapay Zeka Ayarları" Style="{StaticResource SidebarLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <Button Click="OpenUserSettings_Click"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    ToolTip="Kullanıcı Ayarları">
                                <StackPanel Orientation="Horizontal">
                                    <mi:MaterialIcon Kind="AccountCogOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kullanıcı Ayarları" Style="{StaticResource SidebarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ ANA İÇERİK ═══ -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Margin="42,34,42,80"/>

        <!-- ═══ AI ASİSTAN PANELİ ═══ -->
        <views:AIAssistantPanel x:Name="AIPanel"
                                Grid.Column="2"
                                Visibility="Collapsed"
                                DataContext="{Binding AIAssistant}"/>

        </Grid><!-- /BODY -->

        <Canvas x:Name="AiFloatingLayer"
                Grid.RowSpan="2"
                Panel.ZIndex="50"
                ClipToBounds="True"
                SizeChanged="AiFloatingLayer_SizeChanged">
            <Button x:Name="AiFloatingButton"
                    Width="160" Height="46"
                    Cursor="Hand"
                    Click="AiFloatingButton_Click"
                    Loaded="AiFloatingButton_Loaded"
                    FocusVisualStyle="{x:Null}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ToolTip="AI Asistan"
                    Visibility="{Binding AIAssistant.IsPanelOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                MinWidth="160"
                                Height="46"
                                CornerRadius="{DynamicResource RadiusLg}"
                                Background="{DynamicResource AiFloatingBgBrush}"
                                BorderBrush="{DynamicResource AiFloatingBorderBrush}"
                                BorderThickness="1"
                                Effect="{DynamicResource ShadowLg}">
                            <Border CornerRadius="{DynamicResource RadiusLg}"
                                    BorderBrush="{DynamicResource AiFloatingBorderBrush}"
                                    BorderThickness="1"
                                    Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="28"
                                            Height="28"
                                            CornerRadius="{DynamicResource RadiusMd}"
                                            Background="{DynamicResource PrimaryBrush}"
                                            VerticalAlignment="Center"
                                            Effect="{DynamicResource ShadowSm}">
                                        <TextBlock Text="AI"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="EduAI'ya sor"
                                               Foreground="{DynamicResource AiFloatingTextBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="10,0,8,0"/>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AiFloatingHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Canvas>

        <!-- ═══ TOAST BİLDİRİMLERİ ═══ -->
        <ItemsControl Grid.RowSpan="2"
                      ItemsSource="{Binding Toasts.Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,24,24"
                      Panel.ZIndex="999"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="340" Margin="0,8,0,0"
                            Background="{DynamicResource CardBgBrush}"
                            BorderThickness="0,0,0,3"
                            CornerRadius="{DynamicResource RadiusLg}" Padding="16,13"
                            Effect="{DynamicResource ShadowLg}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SlideX" X="340"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <!-- Slide in -->
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SlideX"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- Slide out after 3s (service removes at 3.5s) -->
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:3">
                                        <DoubleAnimation Storyboard.TargetName="SlideX"
                                                         Storyboard.TargetProperty="X"
                                                         To="340" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Success">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Width="18" Height="18"
                                             VerticalAlignment="Top"
                                             Margin="0,1,10,0">
                                <mi:MaterialIcon.Style>
                                    <Style TargetType="mi:MaterialIcon">
                                        <Setter Property="Kind" Value="InformationOutline"/>
                                        <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                <Setter Property="Kind" Value="CheckCircleOutline"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                <Setter Property="Kind" Value="AlertCircleOutline"/>
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                <Setter Property="Kind" Value="AlertOutline"/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </mi:MaterialIcon.Style>
                            </mi:MaterialIcon>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,2,0,0"
                                           Visibility="{Binding Message, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</ui:FluentWindow>
