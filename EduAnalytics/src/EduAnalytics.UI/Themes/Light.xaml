<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   PRIMARY ACCENT — Indigo                           -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#6D45F0" po:Freeze="False"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"    Color="#5933D9" po:Freeze="False"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"   Color="#F0ECFE" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   SEMANTIC                                          -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="SuccessBrush"        Color="#059669" po:Freeze="False"/>
    <SolidColorBrush x:Key="WarningBrush"        Color="#B45309" po:Freeze="False"/>
    <SolidColorBrush x:Key="DangerBrush"         Color="#DC2626" po:Freeze="False"/>
    <SolidColorBrush x:Key="InfoBrush"           Color="#2563EB" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   TEXT                                              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#18181B" po:Freeze="False"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#52525B" po:Freeze="False"/>
    <SolidColorBrush x:Key="SubtleBrush"         Color="#71717A" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   BORDERS                                           -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BorderBrush"         Color="#EBEBEF" po:Freeze="False"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"   Color="#EBEBEF" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   SURFACES                                          -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="CardBgBrush"         Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="PageBgBrush"         Color="#FAFAFA" po:Freeze="False"/>
    <SolidColorBrush x:Key="TopBarBgBrush"       Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="HoverBgBrush"        Color="#F4F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="ClickableCardHoverBrush" Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush"  Color="#FAFAFB" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiSummaryBgBrush"    Color="#F6F3FF" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiSummaryBorderBrush" Color="#DED7FE" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiSummaryRuleBrush"  Color="#E7E1FF" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiFloatingBgBrush"   Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiFloatingHoverBrush" Color="#F7F4FF" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiFloatingBorderBrush" Color="#DED7FE" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiFloatingTextBrush" Color="#312E42" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   SIDEBAR                                            -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="SidebarBgBrush"          Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"      Color="#EBEBEF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"        Color="#F4F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarActiveBgBrush"     Color="#F0ECFE" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarTextBrush"         Color="#52525B" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarActiveTextBrush"   Color="#18181B" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarMutedBrush"        Color="#71717A" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarIconBrush"         Color="#71717A" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarIconActiveBrush"   Color="#6D45F0" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   INTERACTION                                       -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush"      Color="#A8A8B0" po:Freeze="False"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#71717A" po:Freeze="False"/>
    <SolidColorBrush x:Key="SubtleHoverBrush"         Color="#F4F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="GhostHoverBrush"          Color="#F4F4F6" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   COMPONENT TOKENS                                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="DataGridHoverBrush"       Color="#F4F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush"    Color="#EBEBEF" po:Freeze="False"/>
    <SolidColorBrush x:Key="DangerSubtleBrush"        Color="#FEF2F2" po:Freeze="False"/>
    <SolidColorBrush x:Key="CardSubtleBgBrush"        Color="#EFEFF2" po:Freeze="False"/>
    <SolidColorBrush x:Key="WarningSubtleBgBrush"     Color="#FEF3C7" po:Freeze="False"/>
    <SolidColorBrush x:Key="WarningSubtleBorderBrush" Color="#FCD34D" po:Freeze="False"/>
    <SolidColorBrush x:Key="WarningSubtleTextBrush"   Color="#92400E" po:Freeze="False"/>  <!-- amber-800  -->
    <SolidColorBrush x:Key="SuccessSubtleBgBrush"     Color="#ECFDF5" po:Freeze="False"/>
    <SolidColorBrush x:Key="SuccessSubtleBorderBrush" Color="#A7F3D0" po:Freeze="False"/>  <!-- emerald-200 -->
    <SolidColorBrush x:Key="InfoSubtleBgBrush"        Color="#EFF6FF" po:Freeze="False"/>
    <SolidColorBrush x:Key="InfoSubtleBorderBrush"    Color="#BFDBFE" po:Freeze="False"/>  <!-- blue-200    -->
    <SolidColorBrush x:Key="InfoSubtleTextBrush"      Color="#1E40AF" po:Freeze="False"/>  <!-- blue-800    -->
    <SolidColorBrush x:Key="DangerSubtleBorderBrush"  Color="#FECACA" po:Freeze="False"/>  <!-- red-200     -->
    <SolidColorBrush x:Key="DangerEmphasisBrush"      Color="#991B1B" po:Freeze="False"/>  <!-- red-900     -->
    <SolidColorBrush x:Key="SuccessEmphasisBrush"     Color="#065F46" po:Freeze="False"/>  <!-- emerald-900 -->
    <SolidColorBrush x:Key="SuccessSubtleTextBrush"   Color="#065F46" po:Freeze="False"/>  <!-- emerald-900 -->
    <SolidColorBrush x:Key="ChipBgBrush"              Color="#EFEFF2" po:Freeze="False"/>
    <SolidColorBrush x:Key="ChipTextBrush"            Color="#52525B" po:Freeze="False"/>
    <SolidColorBrush x:Key="FocusRingBrush"           Color="#D8CCFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="OverlayBrush"             Color="#80111827" po:Freeze="False"/> <!-- gray-900 50% -->
    <SolidColorBrush x:Key="TooltipBgBrush"           Color="#111827" po:Freeze="False"/>
    <SolidColorBrush x:Key="TooltipFgBrush"           Color="#F9FAFB" po:Freeze="False"/>

    <!-- Splash / login başlangıç paleti — macOS light referansı -->
    <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#FAFAFA" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashForegroundBrush" Color="#18181B" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashMutedBrush"      Color="#71717A" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashSubtleBrush"     Color="#71717A" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashLineBrush"       Color="#EBEBEF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashLoaderBrush"     Color="#6D45F0" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashNoiseBrush"      Color="#18181B" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashPanelBrush"      Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashInputBrush"      Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashActionBrush"     Color="#6D45F0" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashActionTextBrush" Color="#FFFFFF" po:Freeze="False"/>
    <Color x:Key="SplashLogoStartColor">#7C5CFF</Color>
    <Color x:Key="SplashLogoEndColor">#6D45F0</Color>

    <!-- Login ekranı — macOS light referansı -->
    <SolidColorBrush x:Key="LoginWindowBrush"      Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginSidebarBrush"     Color="#F5F5F7" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginTextBrush"        Color="#18181B" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginMutedBrush"       Color="#71717A" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginAccentBrush"      Color="#6D45F0" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginBorderBrush"      Color="#EBEBEF" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginInputBrush"       Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginInputBorderBrush" Color="#C7C7CC" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginSecurityBrush"    Color="#F0ECFE" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   RADIUS TOKENS                                     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusXl">12</CornerRadius>
    <CornerRadius x:Key="Radius2Xl">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   SPACING TOKENS (Thickness)                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Thickness x:Key="Space4">4</Thickness>
    <Thickness x:Key="Space8">8</Thickness>
    <Thickness x:Key="Space12">12</Thickness>
    <Thickness x:Key="Space16">16</Thickness>
    <Thickness x:Key="Space20">20</Thickness>
    <Thickness x:Key="Space24">24</Thickness>
    <Thickness x:Key="Space32">32</Thickness>
    <Thickness x:Key="Space48">48</Thickness>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   ELEVATION / SHADOWS                               -->
    <!-- ═══════════════════════════════════════════════════ -->
    <DropShadowEffect x:Key="ShadowSm"  Color="#000000" Opacity="0.06" BlurRadius="4"  ShadowDepth="1" Direction="270"/>
    <DropShadowEffect x:Key="ShadowMd"  Color="#000000" Opacity="0.08" BlurRadius="10" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="ShadowLg"  Color="#000000" Opacity="0.10" BlurRadius="20" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="ShadowXl"  Color="#000000" Opacity="0.14" BlurRadius="32" ShadowDepth="8" Direction="270"/>

</ResourceDictionary>
