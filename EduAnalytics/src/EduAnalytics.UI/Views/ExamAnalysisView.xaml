<UserControl x:Class="EduAnalytics.UI.Views.ExamAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:ctl="clr-namespace:EduAnalytics.UI.Controls"
             xmlns:conv="clr-namespace:EduAnalytics.UI.Converters"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:ExamAnalysisViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <conv:DonutSegmentGeometryConverter x:Key="DonutSegmentGeometryConverter"/>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="InsightCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InfoSubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,3"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Success">
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessSubtleBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningSubtleBorderBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource WarningSubtleBgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerSubtleBorderBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SummaryCapsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
        </Style>

        <Style x:Key="SummaryMonoValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Geist Mono, JetBrains Mono, Consolas, Menlo, monospace"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="LineHeight" Value="32"/>
        </Style>

        <Style x:Key="SummaryAiBandStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AiSummaryBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AiSummaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>

        <Style x:Key="SummaryAiIconStyle" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Effect" Value="{DynamicResource ShadowSm}"/>
        </Style>

        <Style x:Key="SummaryIconBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="{DynamicResource ChipBgBrush}"/>
        </Style>

        <Style x:Key="SummaryHealthCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Effect" Value="{DynamicResource ShadowSm}"/>
        </Style>

        <Style x:Key="SummarySignalCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,16"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessSubtleBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource WarningSubtleBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningSubtleBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerSubtleBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SummaryPanelStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,20,20,20"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="SummaryStatStripStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SummaryStatItemStyle" TargetType="Border">
            <Setter Property="Padding" Value="22,17"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style x:Key="SummaryPanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="SummaryPanelSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="SummaryPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBgBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="SummaryPillActiveStyle" TargetType="Border" BasedOn="{StaticResource SummaryPillStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
        </Style>

        <Style x:Key="SummaryPillToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ChipBgBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusLg}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AiSummaryBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRootGridStyle}">
        <ScrollViewer Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctl:PageHeader Grid.Row="0"
                        Icon="ChartLineVariant"
                        Title="{Binding Summary.ExamTitle, FallbackValue='Sınav Analizi'}"
                        Subtitle="{Binding ExamAnalysisSubtitle}">
            <ctl:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                <Button Content="AI ile Yorumla"
                        Command="{Binding DataContext.AIAssistant.StartPromptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Bu sınavın genel analizini; güvenilirlik, madde kalitesi, öğrenim çıktısı performansı ve sınav dengesi açısından yorumla."
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="Rapor Çıktısı (PDF)"
                        Command="{Binding ExportReportCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="Cevap Girişi"
                        Command="{Binding OpenAnswerEntryCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </ctl:PageHeader.Actions>
        </ctl:PageHeader>

        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,18">
            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,14,0">
                <StackPanel>
                    <mi:MaterialIcon Kind="TrendingUp" Width="22" Height="22"
                                     Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Style="{StaticResource MetricValueStyle}"
                               Foreground="{DynamicResource SuccessBrush}"
                               Margin="0,10,0,0">
                        <Run Text="%"/>
                        <Run Text="{Binding Summary.AverageSuccessRate, StringFormat={}{0:N1}}"/>
                    </TextBlock>
                    <TextBlock Text="Ort. Başarı" Style="{StaticResource MetricLabelStyle}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,14,0">
                <StackPanel>
                    <mi:MaterialIcon Kind="Pulse" Width="22" Height="22"
                                     Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding Summary.CronbachAlpha, StringFormat={}{0:N3}}"
                               Style="{StaticResource MetricValueStyle}"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="Cronbach α" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock Text="{Binding Summary.CronbachAlphaInterpretation}"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,14,0">
                <StackPanel>
                    <mi:MaterialIcon Kind="ChartBar" Width="22" Height="22"
                                     Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="{Binding Summary.AverageDifficultyIndex, StringFormat={}{0:N3}}"
                               Style="{StaticResource MetricValueStyle}"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="Ort. Güçlük (p)" Style="{StaticResource MetricLabelStyle}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <mi:MaterialIcon Kind="AlertOutline" Width="22" Height="22"
                                     Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Style="{StaticResource MetricValueStyle}"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="0,10,0,0">
                        <Run Text="%"/>
                        <Run Text="{Binding Summary.LowestLearningOutcomeSuccessRate, StringFormat={}{0:N1}}"/>
                    </TextBlock>
                    <TextBlock Text="En Düşük ÖÇ" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock Text="{Binding Summary.LowestLearningOutcomeName}"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- AI destekli analiz kokpiti -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Border Style="{StaticResource BentoCardStyle}"
                    Margin="0"
                    Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="AI Destekli Tanı"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Sınav kalitesini etkileyen ana sinyaller"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Paneli Aç"
                                Command="{Binding DataContext.AIAssistant.TogglePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="10,5"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ExecutiveInsights}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsightCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Value}"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,6,0,4"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="17"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Sekmeler -->
        <TabControl Grid.Row="3"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- ═══ SEKME 1: ÖZET ═══ -->
            <TabItem Header="Özet">
                <StackPanel Margin="0,28,0,0">
                    <!-- Stat strip -->
                    <Border Style="{StaticResource SummaryStatStripStyle}" Margin="0,0,0,22">
                        <UniformGrid Rows="1" Columns="4">
                            <Border Style="{StaticResource SummaryStatItemStyle}">
                                <StackPanel>
                                    <TextBlock Text="ÖĞRENCİ SAYISI" Style="{StaticResource SummaryCapsLabelStyle}"/>
                                    <TextBlock Text="{Binding Summary.TotalStudents}"
                                               Style="{StaticResource SummaryMonoValueStyle}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="Tüm öğrenciler sınava girdi"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource SubtleBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SummaryStatItemStyle}">
                                <StackPanel>
                                    <TextBlock Text="ORTALAMA PUAN" Style="{StaticResource SummaryCapsLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Summary.AverageScore, StringFormat='{}{0:0.00}'}"
                                                   Style="{StaticResource SummaryMonoValueStyle}"/>
                                        <TextBlock Text="{Binding Summary.MaxPossibleScore, StringFormat=' / {0:0.#}'}"
                                                   FontFamily="Geist Mono, JetBrains Mono, Consolas, Menlo, monospace"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource SubtleBrush}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="6,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Statistics.StandardDeviation, StringFormat='Standart sapma: {0:N1}', FallbackValue='Standart sapma: -'}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource SubtleBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SummaryStatItemStyle}">
                                <StackPanel>
                                    <TextBlock Text="BAŞARI ORANI" Style="{StaticResource SummaryCapsLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Summary.AverageSuccessRate, StringFormat={}{0:N1}}"
                                                   Style="{StaticResource SummaryMonoValueStyle}"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Text="%"
                                                   FontFamily="Geist Mono, JetBrains Mono, Consolas, Menlo, monospace"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource SubtleBrush}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="6,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary.PassRate, StringFormat='Geçme oranı: {0:N1}%'}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource SubtleBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SummaryStatItemStyle}" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="EN YÜKSEK / EN DÜŞÜK" Style="{StaticResource SummaryCapsLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Summary.HighestScore, StringFormat={}{0:0.#}}"
                                                   Style="{StaticResource SummaryMonoValueStyle}"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text=" / "
                                                   Style="{StaticResource SummaryMonoValueStyle}"
                                                   Foreground="{DynamicResource SubtleBrush}"/>
                                        <TextBlock Text="{Binding Summary.LowestScore, StringFormat={}{0:0.#}}"
                                                   Style="{StaticResource SummaryMonoValueStyle}"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Geniş varyasyon - gruplar farklı"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource SubtleBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Border>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SummaryPanelStyle}" Grid.Column="0" Margin="0,0,14,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Sınıf Puan Dağılımı"
                                                   Style="{StaticResource SummaryPanelTitleStyle}"/>
                                        <TextBlock Text="Öğrencilerin puan aralıklarına göre dağılımı"
                                                   Style="{StaticResource SummaryPanelSubtitleStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <lvc:CartesianChart Height="260"
                                                    Series="{Binding ScoreDistributionSeries}"
                                                    XAxes="{Binding ScoreDistributionXAxes}"
                                                    LegendPosition="Hidden"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SummaryPanelStyle}" Grid.Column="1">
                            <StackPanel>
                                <TextBlock Text="Genel Doğru Oranı"
                                           Style="{StaticResource SummaryPanelTitleStyle}"/>
                                <TextBlock Text="Tüm sorularda toplam dağılım"
                                           Style="{StaticResource SummaryPanelSubtitleStyle}"
                                           Margin="0,2,0,18"/>
                                <Grid Height="260">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="168" Height="168" VerticalAlignment="Center">
                                        <Ellipse Width="168"
                                                 Height="168"
                                                 Stroke="{DynamicResource ChipBgBrush}"
                                                 StrokeThickness="22"
                                                 Fill="Transparent"/>

                                        <Path Stroke="{DynamicResource SuccessBrush}"
                                              StrokeThickness="22"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource DonutSegmentGeometryConverter}" ConverterParameter="0">
                                                    <Binding Path="CorrectAnswerCount"/>
                                                    <Binding Path="WrongAnswerCount"/>
                                                    <Binding Path="EmptyAnswerCount"/>
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>

                                        <Path Stroke="{DynamicResource DangerBrush}"
                                              StrokeThickness="22"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource DonutSegmentGeometryConverter}" ConverterParameter="1">
                                                    <Binding Path="CorrectAnswerCount"/>
                                                    <Binding Path="WrongAnswerCount"/>
                                                    <Binding Path="EmptyAnswerCount"/>
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>

                                        <Path Stroke="{DynamicResource SubtleBrush}"
                                              StrokeThickness="22"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Opacity="0.55">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource DonutSegmentGeometryConverter}" ConverterParameter="2">
                                                    <Binding Path="CorrectAnswerCount"/>
                                                    <Binding Path="WrongAnswerCount"/>
                                                    <Binding Path="EmptyAnswerCount"/>
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>

                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CorrectAnswerRate, StringFormat={}{0:N1}%}"
                                                       FontFamily="Geist Mono, JetBrains Mono, Consolas, Menlo, monospace"
                                                       FontSize="28"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="DOĞRU"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SubtleBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1"
                                                Margin="24,0,0,0"
                                                VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="9" Height="9" CornerRadius="3" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Doğru" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,12,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CorrectAnswerCount}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding CorrectAnswerRate, StringFormat={}{0:N1}%}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="9" Height="9" CornerRadius="3" Background="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Yanlış" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,12,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding WrongAnswerCount}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding WrongAnswerRate, StringFormat={}{0:N1}%}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="9" Height="9" CornerRadius="3" Background="{DynamicResource SubtleBrush}" Opacity="0.55" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Boş" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,12,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding EmptyAnswerCount}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding EmptyAnswerRate, StringFormat={}{0:N1}%}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"/>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>
                                        <Grid>
                                            <TextBlock Text="Toplam cevap"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource SubtleBrush}"/>
                                            <TextBlock Text="{Binding TotalAnswerCount}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource SummaryPanelStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Soru Bazlı Başarı Oranları"
                                               Style="{StaticResource SummaryPanelTitleStyle}"/>
                                    <TextBlock Text="Her sorunun başarı yüzdesi ve bağlı olduğu öğrenim çıktısı"
                                               Style="{StaticResource SummaryPanelSubtitleStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <ToggleButton Content="% Başarı"
                                                  Style="{StaticResource SummaryPillToggleStyle}"
                                                  IsChecked="{Binding IsSummaryQuestionSuccessSelected, Mode=OneWay}"
                                                  Command="{Binding SelectSummaryQuestionMetricCommand}"
                                                  CommandParameter="Success"/>
                                    <ToggleButton Content="Güçlük (p)"
                                                  Style="{StaticResource SummaryPillToggleStyle}"
                                                  IsChecked="{Binding IsSummaryQuestionDifficultySelected, Mode=OneWay}"
                                                  Command="{Binding SelectSummaryQuestionMetricCommand}"
                                                  CommandParameter="Difficulty"/>
                                    <ToggleButton Content="Ayırt edicilik"
                                                  Style="{StaticResource SummaryPillToggleStyle}"
                                                  IsChecked="{Binding IsSummaryQuestionDiscriminationSelected, Mode=OneWay}"
                                                  Command="{Binding SelectSummaryQuestionMetricCommand}"
                                                  CommandParameter="Discrimination"/>
                                </StackPanel>
                            </Grid>
                            <lvc:CartesianChart Height="320"
                                                Series="{Binding SummaryQuestionSeries}"
                                                XAxes="{Binding SummaryQuestionXAxes}"
                                                YAxes="{Binding SummaryQuestionYAxes}"
                                                LegendPosition="Hidden"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ SEKME 2: ÖĞRENİM ÇIKTILARI ═══ -->
            <TabItem Header="Öğrenim Çıktıları">
                    <StackPanel Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource BentoCardStyle}" Grid.Column="0" Margin="0,0,8,14">
                                <StackPanel>
                                    <TextBlock Text="Çıktı Kapsam Yüzeyi"
                                               Style="{StaticResource SubheadingStyle}"
                                               ToolTip="Her öğrenim çıktısında sınıfın ortalama başarısını gösterir. Düşük kalan alanlar tekrar veya destek gerektirebilir."/>
                                    <lvc:PolarChart Height="280"
                                                    Series="{Binding RadarSeries}"
                                                    AngleAxes="{Binding RadarAxes}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource BentoCardStyle}" Grid.Column="1" Margin="8,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Çıktı Başarı Dağılımı"
                                               Style="{StaticResource SubheadingStyle}"
                                               ToolTip="Başarı oranı = ilgili öğrenim çıktısındaki kazanılan puan / alınabilecek puan x 100."/>
                                    <lvc:CartesianChart Height="280"
                                                        Series="{Binding LearningOutcomeChartSeries}"
                                                        XAxes="{Binding LearningOutcomeChartXAxes}"
                                                        YAxes="{Binding LearningOutcomeChartYAxes}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Detaylı Çıktı Performansı"
                                           Style="{StaticResource SubheadingStyle}"
                                           ToolTip="ÖÇ, ders sonunda öğrencinin kazanması beklenen bilgi veya beceridir. Bu tablo her ÖÇ için kaç soru sorulduğunu ve sınıf başarısını gösterir."/>
                                <ItemsControl ItemsSource="{Binding LearningOutcomes}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Kod rozeti (DTO'da Code yok → OutcomeName ilk kelimesi) -->
                                                    <Border Grid.Column="0"
                                                            Background="{DynamicResource PrimaryLightBrush}"
                                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource RadiusLg}"
                                                            Padding="8,3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OutcomeName, Converter={StaticResource FirstWord}}"
                                                                   Foreground="{DynamicResource PrimaryDarkBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>

                                                    <!-- Label + açıklama -->
                                                    <StackPanel Grid.Column="1"
                                                                Margin="14,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OutcomeName}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding Description, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>

                                                    <!-- Bar -->
                                                    <ProgressBar Grid.Column="2"
                                                                 Style="{StaticResource RateBarStyle}"
                                                                 Value="{Binding SuccessRate, Mode=OneWay}"
                                                                 Foreground="{Binding SuccessRate, Converter={StaticResource RateThresholdToBrush}, ConverterParameter=outcome}"
                                                                 VerticalAlignment="Center"/>

                                                    <!-- Yüzde -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding SuccessRate, StringFormat={}%{0:N1}}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding SuccessRate, Converter={StaticResource RateThresholdToBrush}, ConverterParameter=outcomeText}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
            </TabItem>

            <!-- ═══ SEKME 3: SORULAR (Çeldirici + Sınav Soruları birleşik) ═══ -->
            <TabItem Header="Sorular">
                    <StackPanel Margin="0,16,0,0">
                        <!-- Sınav Soruları (yönetim — iptal) -->
                        <Border Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Sınav Soruları"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <DataGrid ItemsSource="{Binding Questions}" RowHeight="44">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="No" Binding="{Binding QuestionNumber}" Width="60"/>
                                        <DataGridTextColumn Header="Soru Metni" Binding="{Binding QuestionText}" Width="*"/>
                                        <DataGridTextColumn Header="Tür" Binding="{Binding QuestionType}" Width="110"/>
                                        <DataGridTextColumn Header="Puan" Binding="{Binding MaxPoints, StringFormat=N1}" Width="70"/>
                                        <DataGridTextColumn Header="Cevap" Binding="{Binding CorrectOption}" Width="70"/>
                                        <DataGridTemplateColumn Header="" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="İptal"
                                                            Command="{Binding DataContext.CancelQuestionCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Padding="10,4"
                                                            FontSize="11"
                                                            HorizontalAlignment="Center"
                                                            ToolTip="Bu soru iptal edilirse analizlerde puan ve başarı hesaplarına dahil edilmez."/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Çeldirici Uyarı Kutusu -->
                        <Border Style="{StaticResource BentoCardStyle}"
                                Background="{DynamicResource WarningSubtleBgBrush}"
                                BorderBrush="{DynamicResource WarningSubtleBorderBrush}"
                                Visibility="{Binding StrongDistractors.Count, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Width="8" Height="8" CornerRadius="{DynamicResource RadiusLg}"
                                            Background="{DynamicResource WarningBrush}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="Güçlü Çeldirici Tespit Edilen Sorular"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WarningSubtleTextBrush}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Yanlış yapan öğrencilerin %50'sinden fazlasının aynı şıkkı seçtiği sorular."
                                           Foreground="{DynamicResource WarningSubtleTextBrush}"
                                           Margin="0,2,0,12"/>
                                <ItemsControl ItemsSource="{Binding StrongDistractors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource RadiusLg}"
                                                    Padding="12,9"
                                                    Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                                        <Run Text="Soru "/>
                                                        <Run Text="{Binding QuestionNumber}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="  ·  Doğru: "
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding CorrectOption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                    <TextBlock Text="  ·  Çeldirici: "
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding StrongestDistractorOption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="  ("/>
                                                        <Run Text="{Binding StrongestDistractorCount}"/>
                                                        <Run Text=" kişi · %"/>
                                                        <Run Text="{Binding StrongestDistractorRate}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Şık Dağılımı Tablosu -->
                        <Border Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Tüm Soruların Şık Dağılımı"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <DataGrid ItemsSource="{Binding Questions}" RowHeight="36">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Soru" Binding="{Binding QuestionNumber}" Width="55"/>
                                        <DataGridTextColumn Header="Tür" Binding="{Binding QuestionType}" Width="100"/>
                                        <DataGridTextColumn Header="Puan" Binding="{Binding MaxPoints, StringFormat=N1}" Width="60"/>
                                        <DataGridTextColumn Header="Doğru" Binding="{Binding CorrectOption}" Width="60"/>
                                        <DataGridTextColumn Header="Başarı %" Binding="{Binding SuccessRate, StringFormat=N1}" Width="80"/>
                                        <DataGridTextColumn Header="A" Binding="{Binding OptionACount}" Width="45"/>
                                        <DataGridTextColumn Header="B" Binding="{Binding OptionBCount}" Width="45"/>
                                        <DataGridTextColumn Header="C" Binding="{Binding OptionCCount}" Width="45"/>
                                        <DataGridTextColumn Header="D" Binding="{Binding OptionDCount}" Width="45"/>
                                        <DataGridTextColumn Header="E" Binding="{Binding OptionECount}" Width="45"/>
                                        <DataGridTextColumn Header="Çeldirici" Binding="{Binding StrongestDistractorOption}" Width="90"/>
                                        <DataGridTextColumn Header="Çeld. %" Binding="{Binding StrongestDistractorRate, StringFormat=N1}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
            </TabItem>

            <!-- ═══ SEKME 5: SINAV DENGESİ ═══ -->
            <TabItem Header="Sınav Dengesi">
                    <StackPanel Margin="0,16,0,0">
                        <Border Style="{StaticResource BentoCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                                    <TextBlock Text="DENGE SKORU" Style="{StaticResource MetricLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding BalanceReport.BalanceScore, FallbackValue='—'}"
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="/100"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource SubtleBrush}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="2,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Soruların öğrenim çıktıları arasında ne kadar dengeli dağıldığını gösterir."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource CaptionStyle}">
                                        <Run Text="80–100 Mükemmel"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="60–80 İyi"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="40–60 Orta"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="0–40 Dengesiz"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource BentoCardStyle}"
                                Visibility="{Binding BalanceReport.Warnings.Count, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Uyarılar" Style="{StaticResource SubheadingStyle}"/>
                                <ItemsControl ItemsSource="{Binding BalanceReport.Warnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="{DynamicResource RadiusLg}"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8"
                                                    BorderThickness="1,1,1,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSubtleBgBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Severity}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Message}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource AlertSuccessStyle}"
                                Margin="0,0,0,14"
                                Visibility="{Binding BalanceReport.Warnings.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <StackPanel>
                                <TextBlock Text="Sınav dengeli görünüyor"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessEmphasisBrush}"/>
                                <TextBlock Text="Soru dağılımı öğrenim çıktıları arasında makul biçimde yayılmış."
                                           Foreground="{DynamicResource SuccessEmphasisBrush}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Öğrenim Çıktısı Kapsamı"
                                           Style="{StaticResource SubheadingStyle}"
                                           ToolTip="Bu tablo her öğrenim çıktısına kaç soru bağlandığını ve sınav içindeki yüzdesini gösterir."/>
                                <DataGrid ItemsSource="{Binding BalanceReport.LearningOutcomeCoverage}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="80"/>
                                        <DataGridTextColumn Header="Öğrenim Çıktısı" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Soru" Binding="{Binding QuestionCount}" Width="70"/>
                                        <DataGridTextColumn Header="Yüzde" Binding="{Binding Percentage, StringFormat={}{0:N1}%}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
            </TabItem>

            <!-- ═══ SEKME 6: İSTATİSTİKLER (Sınav istatistikleri + Madde analizi) ═══ -->
            <TabItem Header="İstatistikler">
                    <StackPanel Margin="0,16,0,0">
                        <Border Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Sınav Betimsel İstatistikleri"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <TextBlock Text="Merkezi eğilim, dağılım, şekil ve iç tutarlılık ölçüleri."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,-8,0,14"/>

                                <Border Background="{DynamicResource PageBgBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusLg}"
                                        Padding="14,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Geçme Eşiği (%)"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Width="80"
                                                 Text="{Binding AcceptabilityIndex, UpdateSourceTrigger=LostFocus}"
                                                 Margin="12,0,0,0"/>
                                        <TextBlock Text="Geçme Notu:"
                                                   VerticalAlignment="Center"
                                                   Margin="24,0,8,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Statistics.PassingScore, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,14">
                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,4,0">
                                <StackPanel ToolTip="Aritmetik ortalama, tüm öğrencilerin aldığı puanların toplamının öğrenci sayısına bölünmesiyle hesaplanır. Sınıfın sınavdaki genel performans düzeyini hızlıca okumak için kullanılır. Ancak çok düşük veya çok yüksek birkaç puan varsa ortalama bu uç değerlerden etkilenebilir; bu yüzden ortanca ve standart sapma ile birlikte yorumlanmalıdır.">
                                    <TextBlock Text="ARİTMETİK ORTALAMA" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding Statistics.Mean, StringFormat={}{0:N2}, FallbackValue='—'}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                <StackPanel ToolTip="Ortanca, puanlar küçükten büyüğe sıralandığında tam ortada kalan değerdir. Öğrencilerin yarısı bu puanın altında, yarısı üstünde yer alır. Uç değerlerden aritmetik ortalamaya göre daha az etkilendiği için özellikle sınıfta birkaç çok düşük veya çok yüksek puan olduğunda daha dengeli bir merkez bilgisi verir.">
                                    <TextBlock Text="ORTANCA" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding Statistics.Median, StringFormat={}{0:N2}, FallbackValue='—'}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                <StackPanel ToolTip="Tepe değer, sınıfta en sık tekrar eden puandır. Öğrencilerin hangi puan çevresinde yoğunlaştığını ve sınav sonucunda en tipik puan davranışının nerede oluştuğunu gösterir.">
                                    <TextBlock Text="TEPE DEĞER" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding Statistics.Mode, StringFormat={}{0:N2}, FallbackValue='—'}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0,0,0">
                                <StackPanel ToolTip="Ranj, en yüksek puandan en düşük puanın çıkarılmasıyla bulunur. Sınavdaki en başarılı öğrenci ile en düşük performans arasındaki toplam mesafeyi gösterir.">
                                    <TextBlock Text="RANJ" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding Statistics.Range, StringFormat={}{0:N2}, FallbackValue='—'}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Konum Ölçüleri (Çeyrekler)"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <UniformGrid Rows="1" Columns="5" Margin="0,8,0,0">
                                    <StackPanel ToolTip="Q1 birinci çeyrektir. Puanlar küçükten büyüğe sıralandığında öğrencilerin yaklaşık yüzde 25'i bu değerin altında, yüzde 75'i üstünde kalır.">
                                        <TextBlock Text="{Binding Statistics.Q1, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="Q1" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="Q3 üçüncü çeyrektir. Puanlar küçükten büyüğe sıralandığında öğrencilerin yaklaşık yüzde 75'i bu değerin altında, yüzde 25'i üstünde kalır.">
                                        <TextBlock Text="{Binding Statistics.Q3, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="Q3" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="IQR, Q3 ile Q1 arasındaki farktır. En düşük ve en yüksek uçları dışarıda bırakarak sınıfın ortadaki yüzde 50'lik bölümünün ne kadar yayıldığını gösterir.">
                                        <TextBlock Text="{Binding Statistics.InterquartileRange, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="IQR (Q3−Q1)" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="Çeyrek kayma, IQR değerinin ikiye bölünmesiyle hesaplanır. Orta gruptaki puanların ortanca çevresinde yaklaşık ne kadar dağıldığını daha okunabilir bir ölçüye indirger.">
                                        <TextBlock Text="{Binding Statistics.SemiInterquartileRange, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="Çeyrek Kayma" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="ÇKDK, çeyrekler arası göreli değişkenlik katsayısıdır: (Q3 - Q1) / (Q3 + Q1). Puan ölçeği veya toplam puan farklı olsa bile sınavlar arasında orta grubun göreli yayılımını karşılaştırmayı kolaylaştırır.">
                                        <TextBlock Text="{Binding Statistics.QuartileCoefficient, StringFormat={}{0:N3}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="ÇKDK" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Dağılım (Yayılım) Ölçüleri"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <UniformGrid Rows="1" Columns="5" Margin="0,8,0,0">
                                    <StackPanel ToolTip="Standart sapma, puanların aritmetik ortalamadan ne kadar uzaklaştığını gösterir. Büyük değer, öğrenciler arasındaki başarı farkının arttığını ve sınıfın homojen olmadığını anlatır.">
                                        <TextBlock Text="{Binding Statistics.StandardDeviation, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="Standart Sapma (σ)" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="MAD, her öğrencinin puanının ortalamadan mutlak uzaklığının ortalamasıdır.">
                                        <TextBlock Text="{Binding Statistics.MeanAbsoluteDeviation, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="MAD" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="MedAD, puanların ortancadan ortalama mutlak uzaklığını gösterir.">
                                        <TextBlock Text="{Binding Statistics.MedianAbsoluteDeviation, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="MedAD" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="Standart hata, hesaplanan ortalamanın örneklemden örnekleme ne kadar değişebileceğini gösterir.">
                                        <TextBlock Text="{Binding Statistics.StandardError, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="Standart Hata (SE)" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="BDK/CV, standart sapmanın ortalamaya oranının yüzde olarak ifade edilmesidir.">
                                        <TextBlock Text="{Binding Statistics.CoefficientOfVariation, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="BDK (CV %)" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource BentoCardStyle}" Grid.Column="0" Margin="0,0,4,14">
                                <StackPanel>
                                    <TextBlock Text="Dağılım Şekli"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <UniformGrid Rows="1" Columns="2" Margin="0,8,0,0">
                                        <StackPanel ToolTip="Çarpıklık, puan dağılımının sağa veya sola kayıp kaymadığını gösterir. 0'a yakın değer daha dengeli bir dağılıma işaret eder.">
                                            <TextBlock Text="{Binding Statistics.Skewness, StringFormat={}{0:N3}, FallbackValue='—'}"
                                                       Style="{StaticResource StatValueStyle}"/>
                                            <TextBlock Text="Çarpıklık" Style="{StaticResource StatCaptionStyle}"/>
                                        </StackPanel>
                                        <StackPanel ToolTip="Basıklık, dağılımın normal dağılıma göre ne kadar sivri veya yayvan olduğunu gösterir.">
                                            <TextBlock Text="{Binding Statistics.Kurtosis, StringFormat={}{0:N3}, FallbackValue='—'}"
                                                       Style="{StaticResource StatValueStyle}"/>
                                            <TextBlock Text="Basıklık" Style="{StaticResource StatCaptionStyle}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource BentoCardStyle}" Grid.Column="1" Margin="4,0,0,14">
                                <StackPanel ToolTip="Cronbach alfa, sınavdaki maddelerin aynı genel beceriyi veya kazanım alanını ne kadar tutarlı ölçtüğünü gösterir. 0.80 üzeri çoğu durumda güçlü iç tutarlılık olarak yorumlanır.">
                                    <TextBlock Text="İç Tutarlılık (Cronbach α)"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <TextBlock Text="{Binding Statistics.CronbachAlpha, StringFormat={}{0:N3}, FallbackValue='—'}"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Statistics.CronbachAlphaInterpretation}"
                                               HorizontalAlignment="Center"
                                               FontWeight="Medium"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Geçme / Kalma Durumu"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <UniformGrid Rows="1" Columns="3" Margin="0,8,0,0">
                                    <StackPanel ToolTip="Geçen öğrenci sayısı, geçme eşiğini aşan öğrencilerin toplamıdır.">
                                        <TextBlock Text="{Binding Statistics.PassedStudentCount, FallbackValue='—'}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="GEÇEN" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="Kalan öğrenci sayısı, geçme eşiğinin altında kalan öğrencilerin toplamıdır.">
                                        <TextBlock Text="{Binding Statistics.FailedStudentCount, FallbackValue='—'}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                        <TextBlock Text="KALAN" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="Geçme oranı = geçen öğrenci sayısı / sınava giren öğrenci sayısı x 100.">
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryBrush}">
                                            <Run Text="%"/>
                                            <Run Text="{Binding Statistics.PassRate, StringFormat={}{0:N1}, FallbackValue='—'}"/>
                                        </TextBlock>
                                        <TextBlock Text="GEÇME ORANI" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <!-- Madde Analizi alt-bölümü -->
                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,8,0,16"
                                Padding="0,16,0,0">
                            <TextBlock Text="Madde Analizi"
                                       Style="{StaticResource HeadingStyle}"
                                       Margin="0"/>
                        </Border>

                        <Border Style="{StaticResource AlertInfoStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Klasik Test Geliştirme — Madde Analizi"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource PrimaryDarkBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           LineHeight="20">
                                    <Run FontWeight="SemiBold" Text="Güçlük (p):"/><Run Text=" doğru cevaplayan öğrenci sayısının toplam öğrenci sayısına oranıdır. 1'e yaklaştıkça madde kolay, 0'a yaklaştıkça zor."/>
                                    <LineBreak/>
                                    <Run FontWeight="SemiBold" Text="Ayırt edicilik (D):"/><Run Text=" üst %27 başarı grubunun doğru oranından alt %27 grubun oranı çıkarılarak hesaplanır."/>
                                    <LineBreak/>
                                    <Run FontWeight="SemiBold" Text="Madde güvenilirliği:"/><Run Text=" D × √(p·(1−p)) — güçlük ve ayırt ediciliği birlikte değerlendirir."/>
                                    <LineBreak/>
                                    <Run FontWeight="SemiBold" Text="Çeldirici etkinliği:"/><Run Text=" %5 ve üzeri seçilen yanlış şıklar çalışıyor kabul edilir."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource BentoCardStyle}" Grid.Column="0" Margin="0,0,4,14">
                                <StackPanel>
                                    <TextBlock Text="Madde Güçlük İndeksleri (p)"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <lvc:CartesianChart Height="260"
                                                        Series="{Binding DifficultyChartSeries}"
                                                        XAxes="{Binding DifficultyChartXAxes}"
                                                        YAxes="{Binding DifficultyChartYAxes}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource BentoCardStyle}" Grid.Column="1" Margin="4,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Madde Ayırt Edicilik İndeksleri (D)"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <lvc:CartesianChart Height="260"
                                                        Series="{Binding DiscriminationChartSeries}"
                                                        XAxes="{Binding DiscriminationChartXAxes}"
                                                        YAxes="{Binding DiscriminationChartYAxes}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Üst Grup (%27) vs Alt Grup (%27) Doğru Sayıları"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <lvc:CartesianChart Height="280"
                                                    Series="{Binding UpperLowerSeries}"
                                                    XAxes="{Binding UpperLowerXAxes}"
                                                    YAxes="{Binding UpperLowerYAxes}"
                                                    LegendPosition="Top"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Tüm Öğrencilerin Cevap Dağılımı"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <TextBlock Text="Doğru / Yanlış / Boş"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,-8,0,12"/>
                                <lvc:CartesianChart Height="280"
                                                    Series="{Binding AnswerDistributionSeries}"
                                                    XAxes="{Binding AnswerDistributionXAxes}"
                                                    YAxes="{Binding AnswerDistributionYAxes}"
                                                    LegendPosition="Top"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BentoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Madde Analizi Listesi"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <DataGrid ItemsSource="{Binding ItemAnalysis}" RowHeight="36">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Soru" Binding="{Binding QuestionNumber}" Width="55"/>
                                        <DataGridTextColumn Header="Doğru Şık" Binding="{Binding CorrectOption}" Width="80"/>
                                        <DataGridTextColumn Header="N" Binding="{Binding TotalStudents}" Width="50"/>
                                        <DataGridTextColumn Header="Doğru" Binding="{Binding CorrectCount}" Width="60"/>
                                        <DataGridTextColumn Header="Yanlış" Binding="{Binding WrongCount}" Width="60"/>
                                        <DataGridTextColumn Header="Boş" Binding="{Binding EmptyCount}" Width="50"/>
                                        <DataGridTemplateColumn Header="Güçlük (p)" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Grid.Column="0"
                                                                     Style="{StaticResource RateBarStyle}"
                                                                     Minimum="0" Maximum="1"
                                                                     Value="{Binding DifficultyIndex, Mode=OneWay}"
                                                                     Foreground="{Binding DifficultyIndex, Converter={StaticResource RateThresholdToBrush}, ConverterParameter=difficulty}"
                                                                     VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DifficultyIndex, StringFormat={}{0:N2}}"
                                                                   Style="{StaticResource RateValueTextStyle}"
                                                                   Margin="8,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Güçlük Düzeyi" Binding="{Binding DifficultyCategory}" Width="120"/>
                                        <DataGridTemplateColumn Header="Ayırt Ed. (D)" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Grid.Column="0"
                                                                     Style="{StaticResource RateBarStyle}"
                                                                     Minimum="0" Maximum="1"
                                                                     Value="{Binding DiscriminationIndex, Mode=OneWay}"
                                                                     Foreground="{Binding DiscriminationIndex, Converter={StaticResource RateThresholdToBrush}, ConverterParameter=discrimination}"
                                                                     VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DiscriminationIndex, StringFormat={}{0:N2}}"
                                                                   Style="{StaticResource RateValueTextStyle}"
                                                                   Margin="8,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Ayırt Ed. Düzeyi" Binding="{Binding DiscriminationCategory}" Width="140"/>
                                        <DataGridTextColumn Header="Madde Güv." Binding="{Binding ItemReliabilityIndex, StringFormat=N3}" Width="100"/>
                                        <DataGridTextColumn Header="Çeldirici Etk." Binding="{Binding DistractorEffectivenessIndex, StringFormat=N2}" Width="110"/>
                                        <DataGridTextColumn Header="Üst (Doğru)" Binding="{Binding UpperGroupCorrect}" Width="90"/>
                                        <DataGridTextColumn Header="Alt (Doğru)" Binding="{Binding LowerGroupCorrect}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
            </TabItem>

            <!-- ═══ SEKME 8: ÖĞRENCİ SIRALAMASI ═══ -->
            <TabItem Header="Öğrenci Sıralaması">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource CardSubtleStyle}"
                            Margin="0,0,0,12"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Sınıf / Bölüm Filtresi"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                            <ComboBox Width="240"
                                      Margin="14,0,0,0"
                                      ItemsSource="{Binding AvailableClasses}"
                                      SelectedItem="{Binding SelectedClass}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource BentoCardStyle}" Margin="0">
                        <DataGrid ItemsSource="{Binding FilteredStudents}" RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sıra" Binding="{Binding ClassRank}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Öğrenci No" Binding="{Binding StudentNumber}" Width="110"/>
                                <DataGridTextColumn Header="Sınıf / Bölüm" Binding="{Binding ClassName}" Width="160"/>
                                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Doğru" Binding="{Binding CorrectAnswers}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Yanlış" Binding="{Binding WrongAnswers}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Boş" Binding="{Binding EmptyAnswers}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Başarı %" Binding="{Binding SuccessRate, StringFormat=N1}" Width="100"/>
                                <DataGridTemplateColumn Header="Zayıf Öğrenim Çıktıları" Width="240">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding WeakLearningOutcomes}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource DangerSubtleBrush}"
                                                                BorderBrush="{DynamicResource DangerSubtleBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{DynamicResource RadiusLg}"
                                                                Padding="8,3"
                                                                Margin="0,2,6,2"
                                                                ToolTip="Bu öğrencinin ilgili öğrenim çıktısındaki başarı oranı %50'nin altında.">
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="11"
                                                                       FontWeight="Medium"
                                                                       Foreground="{DynamicResource DangerEmphasisBrush}"
                                                                       TextWrapping="Wrap"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        </Grid>
        </ScrollViewer>

        <!-- Yükleme overlay -->
        <views:LoadingOverlay Message="Analiz hesaplanıyor..."
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Hata kartı -->
        <Border Style="{StaticResource AlertErrorStyle}"
                MaxWidth="640"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="22,18"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Analiz Yüklenirken Hata Oluştu"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DangerBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerEmphasisBrush}"
                           FontFamily="Geist Mono, JetBrains Mono, Consolas, Menlo, monospace"
                           FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
