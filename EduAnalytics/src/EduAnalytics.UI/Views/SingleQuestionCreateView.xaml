<UserControl x:Class="EduAnalytics.UI.Views.SingleQuestionCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:ctl="clr-namespace:EduAnalytics.UI.Controls"
             xmlns:enums="clr-namespace:EduAnalytics.Core.Enums;assembly=EduAnalytics.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:EduAnalytics.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1000">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="QuestionTypeValues"
                            MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:QuestionType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style x:Key="OptionLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ctl:PageHeader Grid.Row="0"
                        Icon="HelpBoxMultipleOutline"
                        Title="Yeni Soru Oluştur"
                        Subtitle="Tek bir soru veya ortak gövdeli (ilişkili) bir soru grubu ekleyebilirsiniz."/>

        <TabControl Grid.Row="1">

            <!-- ═══ Sekme 1: Tek Soru ═══ -->
            <TabItem Header="Tek Soru">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel Margin="0,0,0,16">
                            <Border Style="{StaticResource FormFlowPanelStyle}">
                                <UniformGrid Columns="4">
                                    <StackPanel Style="{StaticResource FormFlowStepStyle}">
                                        <Border Style="{StaticResource FormFlowNumberStyle}">
                                            <TextBlock Text="1" Style="{StaticResource FormFlowNumberTextStyle}"/>
                                        </Border>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Ders" Style="{StaticResource FormFlowTitleStyle}"/>
                                            <TextBlock Text="Bağlamı seç" Style="{StaticResource FormFlowCaptionStyle}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource FormFlowStepStyle}">
                                        <Border Style="{StaticResource FormFlowNumberStyle}">
                                            <TextBlock Text="2" Style="{StaticResource FormFlowNumberTextStyle}"/>
                                        </Border>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Soru" Style="{StaticResource FormFlowTitleStyle}"/>
                                            <TextBlock Text="Tip, metin ve puan" Style="{StaticResource FormFlowCaptionStyle}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource FormFlowStepStyle}">
                                        <Border Style="{StaticResource FormFlowNumberStyle}">
                                            <TextBlock Text="3" Style="{StaticResource FormFlowNumberTextStyle}"/>
                                        </Border>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="ÖÇ bağlantısı" Style="{StaticResource FormFlowTitleStyle}"/>
                                            <TextBlock Text="Ölçülen çıktıları işaretle" Style="{StaticResource FormFlowCaptionStyle}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource FormFlowStepStyle}" Margin="0">
                                        <Border Style="{StaticResource FormFlowNumberStyle}">
                                            <TextBlock Text="4" Style="{StaticResource FormFlowNumberTextStyle}"/>
                                        </Border>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Kaydet" Style="{StaticResource FormFlowTitleStyle}"/>
                                            <TextBlock Text="Bankaya ekle" Style="{StaticResource FormFlowCaptionStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <!-- Temel Bilgiler -->
                            <Border Style="{StaticResource BentoCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Temel Bilgiler" Style="{StaticResource CardHeaderStyle}"/>
                                    <TextBlock Text="Ders seçimi, öğrenim çıktısı listesini ve raporlamadaki bağlamı belirler."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Margin="0,-8,0,14"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Ders" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Courses}"
                                              SelectedItem="{Binding SelectedCourse}"
                                              DisplayMemberPath="Name"
                                              Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CourseError}"
                                               Style="{StaticResource FormErrorTextStyle}"
                                               Visibility="{Binding CourseError, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Soru Detayı -->
                            <Border Style="{StaticResource BentoCardStyle}" DataContext="{Binding Question}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Text="Soru Detayı"
                                                   Style="{StaticResource CardHeaderStyle}"
                                                   Margin="0"/>

                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding Source={StaticResource QuestionTypeValues}}"
                                                  SelectedItem="{Binding Type}"
                                                  VerticalAlignment="Center">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="MultipleChoice">
                                                                        <Setter Property="Text" Value="Test"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="OpenEnded">
                                                                        <Setter Property="Text" Value="Klasik"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Column="4"
                                                   Text="Puan"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Grid.Column="6"
                                                 Text="{Binding MaxPoints, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="80"
                                                 VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Style="{StaticResource CardSubtleStyle}" Margin="0,0,0,14">
                                        <TextBlock Text="Test sorularında doğru şık seçimi zorunludur; klasik sorularda cevap anahtarı değerlendirme rehberi olarak saklanır."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Text="{Binding MaxPointsError}"
                                               Style="{StaticResource FormErrorTextStyle}"
                                               Visibility="{Binding MaxPointsError, Converter={StaticResource BoolToVisibility}}"
                                               Margin="0,-6,0,12"/>

                                    <TextBlock Text="Soru Metni" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="72"
                                             VerticalContentAlignment="Top"
                                             Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding QuestionTextError}"
                                               Style="{StaticResource FormErrorTextStyle}"
                                               Visibility="{Binding QuestionTextError, Converter={StaticResource BoolToVisibility}}"
                                               Margin="0,0,0,12"/>

                                    <!-- Çoktan Seçmeli -->
                                    <StackPanel Visibility="{Binding IsMultipleChoice, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Şıklar" Style="{StaticResource LabelStyle}"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="A" Style="{StaticResource OptionLabelStyle}"/>
                                            <TextBox Grid.Column="1" Text="{Binding OptionA, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Column="3" Text="B" Style="{StaticResource OptionLabelStyle}"/>
                                            <TextBox Grid.Column="4" Text="{Binding OptionB, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="C" Style="{StaticResource OptionLabelStyle}"/>
                                            <TextBox Grid.Column="1" Text="{Binding OptionC, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Column="3" Text="D" Style="{StaticResource OptionLabelStyle}"/>
                                            <TextBox Grid.Column="4" Text="{Binding OptionD, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="E" Style="{StaticResource OptionLabelStyle}"/>
                                            <TextBox Grid.Column="1" Text="{Binding OptionE, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding OptionsError}"
                                                   Style="{StaticResource FormErrorTextStyle}"
                                                   Visibility="{Binding OptionsError, Converter={StaticResource BoolToVisibility}}"
                                                   Margin="0,-8,0,12"/>

                                        <TextBlock Text="Doğru Şık" Style="{StaticResource LabelStyle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <RadioButton Content="A" Margin="0,0,20,0" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=A}"/>
                                            <RadioButton Content="B" Margin="0,0,20,0" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=B}"/>
                                            <RadioButton Content="C" Margin="0,0,20,0" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=C}"/>
                                            <RadioButton Content="D" Margin="0,0,20,0" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=D}"/>
                                            <RadioButton Content="E" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=E}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Klasik -->
                                    <StackPanel Visibility="{Binding IsOpenEnded, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Cevap Anahtarı / Notlandırma Rehberi" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding AnswerKey, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="72"
                                                 VerticalContentAlignment="Top"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Öğrenim Çıktıları -->
                            <Border Style="{StaticResource BentoCardStyle}" DataContext="{Binding Question}">
                                <StackPanel>
                                    <TextBlock Text="Öğrenim Çıktıları" Style="{StaticResource CardHeaderStyle}"/>
                                    <TextBlock Text="Bu soruyla ilişkilendirilecek öğrenim çıktılarını seçin."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,-8,0,12"/>

                                    <TextBox Text="{Binding LearningOutcomeFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"
                                             ToolTip="Kod veya isim ile filtreleyin"/>

                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusLg}"
                                            MinHeight="160"
                                            Margin="0,0,0,12">
                                        <ListBox ItemsSource="{Binding LearningOutcomesView}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="6">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,2"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="6">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                                       Text="{Binding Code}"/>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <TextBlock Text="Seçili Çıktılar" Style="{StaticResource LabelStyle}"
                                               Visibility="{Binding SelectedLearningOutcomes.Count, Converter={StaticResource BoolToVisibility}}"/>

                                    <ItemsControl ItemsSource="{Binding SelectedLearningOutcomes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PrimaryLightBrush}"
                                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource RadiusLg}"
                                                        Padding="8,5"
                                                        Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <StackPanel>
                                                            <TextBlock Foreground="{DynamicResource PrimaryDarkBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Code}"/>
                                                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontSize="11"
                                                                       Text="{Binding Name}"/>
                                                        </StackPanel>
                                                        <Button Content="✕"
                                                                Command="{Binding DataContext.RemoveLearningOutcomeCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Foreground="{DynamicResource PrimaryDarkBrush}"
                                                                Padding="6,2"
                                                                FontSize="11"
                                                                FontWeight="Bold"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border Style="{StaticResource AlertErrorStyle}"
                                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerEmphasisBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <Border Style="{StaticResource AlertSuccessStyle}"
                                        Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessEmphasisBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Kaydet"
                                    Command="{Binding SaveCommand}"
                                    IsEnabled="{Binding IsSaving, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="28,12"
                                    FontSize="14"
                                    Margin="20,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ Sekme 2: İlişkili Soru ═══ -->
            <TabItem Header="İlişkili Soru">
                <ContentControl Content="{Binding GroupEditor}" Margin="0,16,0,0">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:QuestionGroupEditorViewModel}">
                            <views:QuestionGroupEditorView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
