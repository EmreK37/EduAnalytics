<UserControl x:Class="EduAnalytics.UI.Views.AnswerEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:ctl="clr-namespace:EduAnalytics.UI.Controls"
             d:DataContext="{d:DesignInstance Type=vm:AnswerEntryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctl:PageHeader Grid.Row="0"
                        Icon="ClipboardListOutline"
                        Title="Cevap Girişi"
                        Subtitle="{Binding ExamTitle}">
            <ctl:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                <Button Content="Excel İndir"
                        Command="{Binding DownloadExcelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        ToolTip="Boş cevap şablonunu Excel olarak indir"/>
                <Button Content="Excel Yükle"
                        Command="{Binding ImportExcelCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Doldurulmuş Excel dosyasını sisteme yükle"/>
                </StackPanel>
            </ctl:PageHeader.Actions>
        </ctl:PageHeader>

        <!-- Bilgi Bandı -->
        <Border Grid.Row="1" Style="{StaticResource AlertInfoStyle}" Margin="0,0,0,12">
            <TextBlock Foreground="{DynamicResource PrimaryDarkBrush}" FontSize="12" TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="İpuçları:"/>
                <Run Text=" "/>
                <Run FontWeight="SemiBold" Text="Tab"/>
                <Run Text=" sağa, "/>
                <Run FontWeight="SemiBold" Text="Enter"/>
                <Run Text=" alta geçer. Test soruları için A/B/C/D/Boş, klasik sorular için 0 ile maksimum puan arası sayı girin. Bitince Kaydet butonuna basın."/>
            </TextBlock>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource BentoCardStyle}" Margin="0" Padding="0">
            <DataGrid x:Name="AnswersGrid"
                      ItemsSource="{Binding StudentRows}"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                      RowHeight="42"
                      ColumnHeaderHeight="44"
                      FrozenColumnCount="2"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"/>
        </Border>

        <!-- Alt Bar -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Style="{StaticResource AlertErrorStyle}"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerEmphasisBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Style="{StaticResource AlertSuccessStyle}"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessEmphasisBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                    <Button Content="Geri"
                            Command="{Binding GoBackCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="20,12"
                            FontSize="14"
                            Margin="0,0,8,0"/>
                    <Button Content="Kaydet"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="28,12"
                            FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <views:LoadingOverlay Grid.Row="0" Grid.RowSpan="4"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
