<Window x:Class="EduAnalytics.UI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduAnalytics"
        Width="420"
        Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Border Background="{DynamicResource SplashBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius2Xl}"
            Effect="{DynamicResource ShadowXl}"
            ClipToBounds="True"
            MouseLeftButtonDown="OnDragAreaMouseLeftButtonDown">
        <Grid Style="{StaticResource PageRootGridStyle}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,-6,0,0">
                <Border Width="64"
                        Height="64"
                        CornerRadius="{DynamicResource Radius2Xl}"
                        Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource SplashLogoStartColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource SplashLogoEndColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#5E5CE6"
                                          Direction="270"
                                          ShadowDepth="8"
                                          BlurRadius="18"
                                          Opacity="0.34"/>
                    </Border.Effect>

                    <Viewbox Width="36"
                             Height="36"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M22 10 L22 16"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"/>
                            <Path Data="M2 10 L12 5 L22 10 L12 15 Z"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"/>
                            <Path Data="M6 12 L6 17 C9 20 15 20 18 17 L18 12"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <TextBlock Text="EduAnalytics"
                           Foreground="{DynamicResource SplashForegroundBrush}"
                           FontFamily="Geist, Inter, Segoe UI Variable, Segoe UI, system-ui"
                           FontSize="24"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Ölçme değerlendirme paneli"
                           Foreground="{DynamicResource SplashMutedBrush}"
                           FontFamily="Geist, Inter, Segoe UI Variable, Segoe UI, system-ui"
                           FontSize="13"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,32"/>

                <Grid Width="200"
                      Height="4"
                      Background="{DynamicResource SplashLineBrush}"
                      ClipToBounds="True">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,200,4" RadiusX="2" RadiusY="2"/>
                    </Grid.Clip>

                    <Border Width="60"
                            Height="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource SplashLoaderBrush}"
                            CornerRadius="2">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LoaderTransform" X="-60"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </StackPanel>

            <TextBlock Text="Versiyon 1.0"
                       Foreground="{DynamicResource SplashMutedBrush}"
                           FontFamily="Geist, Inter, Segoe UI Variable, Segoe UI, system-ui"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,16"/>
        </Grid>
    </Border>
</Window>
