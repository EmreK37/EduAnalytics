<UserControl x:Class="EduAnalytics.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="DashboardKpiCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="20,18,20,16"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Effect" Value="{DynamicResource ShadowSm}"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource ClickableCardHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardExamCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Effect" Value="{DynamicResource ShadowSm}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource ClickableCardHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardLabelCapsStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="DashboardMonoValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="LineHeight" Value="34"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DashboardCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DashboardIconBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="DashboardMetaChipStyle" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource ChipBgBrush}"/>
        </Style>

        <Style x:Key="QuickActionCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Width="Auto"
                  MaxWidth="1500"
                  Margin="40,36,40,80"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- PAGE HEAD -->
                <Grid Grid.Row="0" Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   LineHeight="42">
                            <Run Text="İyi çalışmalar," />
                            <Run Text="{Binding DisplayUserName, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" />
                        </TextBlock>
                        <TextBlock Text="Sınav performansı, güvenlik analizleri ve öğrenci durumu hakkında günlük özet tablonuz."
                                   FontSize="15"
                                   LineHeight="22"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource SubtleBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- KPI GRID -->
                <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,36">
                    <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="ANALİZE HAZIR" Style="{StaticResource DashboardLabelCapsStyle}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource DashboardIconBoxStyle}" Background="#E0F2FE" HorizontalAlignment="Right">
                                    <mi:MaterialIcon Kind="FileDocumentMultipleOutline" Width="18" Height="18" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                                <TextBlock Text="{Binding Exams.Count}" Style="{StaticResource DashboardMonoValueStyle}"/>
                                <TextBlock Text=" Sınav" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,18,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="Yeni analiz bekleniyor" Style="{StaticResource DashboardCaptionStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="KAYITLI ÖĞRENCİ" Style="{StaticResource DashboardLabelCapsStyle}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource DashboardIconBoxStyle}" Background="#DCFCE7" HorizontalAlignment="Right">
                                    <mi:MaterialIcon Kind="AccountGroup" Width="18" Height="18" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                                <TextBlock Text="{Binding StudentCount}" Style="{StaticResource DashboardMonoValueStyle}"/>
                                <Border Background="#DCFCE7" CornerRadius="8" Padding="6,2" Margin="10,4,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="+2 Yeni" FontSize="12" Foreground="#16A34A" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,18,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="Bu dönem güncel kayıtlar" Style="{StaticResource DashboardCaptionStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="GENEL ORT. BAŞARI" Style="{StaticResource DashboardLabelCapsStyle}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource DashboardIconBoxStyle}" Background="#FEF3C7" HorizontalAlignment="Right">
                                    <mi:MaterialIcon Kind="TrendingUp" Width="18" Height="18" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                                <TextBlock Text="{Binding OverallAverageSuccessRate, StringFormat={}{0:N1}}" Style="{StaticResource DashboardMonoValueStyle}"/>
                                <TextBlock Text="%" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,18,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="Tüm sınavlardaki genel başarı" Style="{StaticResource DashboardCaptionStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashboardKpiCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="SON AKTİVİTE" Style="{StaticResource DashboardLabelCapsStyle}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource DashboardIconBoxStyle}" Background="#F3E8FF" HorizontalAlignment="Right">
                                    <mi:MaterialIcon Kind="CalendarClock" Width="18" Height="18" Foreground="#9333EA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                                <TextBlock Text="{Binding LastActivityDate}" Style="{StaticResource DashboardMonoValueStyle}" FontSize="24" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,18,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="En son sistem hareketi" Style="{StaticResource DashboardCaptionStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- MAIN CONTENT AREA: 2 COLUMNS -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- SOL: EXAM LIST -->
                    <Grid Grid.Column="0" Margin="0,0,32,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Son Sınav Performansları" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding FilteredExams}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DashboardExamCardStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenAnalysisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Border.InputBindings>

                                        <Grid Margin="24,20,24,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ExamTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border Background="{DynamicResource WarningSubtleBgBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Analiz Bekliyor" Margin="6,0,0,0" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource DashboardMetaChipStyle}" Margin="10,0,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <mi:MaterialIcon Kind="CalendarClock" Width="14" Height="14" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ExamDate, StringFormat='{}{0:dd MMMM yyyy}'}" Margin="6,0,0,0" Style="{StaticResource ChipText}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource DashboardMetaChipStyle}" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding CourseName}" Style="{StaticResource ChipText}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Güvenilirlik ve öğrenim çıktısı riskleri için detaylı analize geçin." FontSize="13" Foreground="{DynamicResource SubtleBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel Width="80" HorizontalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding TotalStudents}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="ÖĞRENCİ" Style="{StaticResource DashboardLabelCapsStyle}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Width="80" HorizontalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding TotalQuestions}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="SORU" Style="{StaticResource DashboardLabelCapsStyle}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Width="90" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding AverageSuccessRate, StringFormat={}{0:N1}%}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="BAŞARI" Style="{StaticResource DashboardLabelCapsStyle}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- SAĞ: HIZLI İŞLEMLER -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Hızlı İşlemler" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <StackPanel Grid.Row="1">
                            <!-- Optik Okuma -->
                            <Border Style="{StaticResource QuickActionCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
                                        <mi:MaterialIcon Kind="Scanner" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="Optik Okuma" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Formları tara ve içeri aktar" FontSize="12.5" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Sınav Yönetimi -->
                            <Border Style="{StaticResource QuickActionCardStyle}" Margin="0,4,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SecondaryBrush}" VerticalAlignment="Center">
                                        <mi:MaterialIcon Kind="FileDocumentEditOutline" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="Sınav Yönetimi" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Yeni sınav oluştur veya düzenle" FontSize="12.5" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Sistem Durumu -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="16,16" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Sistem Durumu" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Veritabanı bağlantısı aktif" FontSize="13" Foreground="{DynamicResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Yapay Zeka (AI) servisi çevrimiçi" FontSize="13" Foreground="{DynamicResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bekleyen 2 analiz raporu" FontSize="13" Foreground="{DynamicResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- AI Assistant Banner -->
                            <Border Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="14" Padding="16,16" Margin="0,20,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <mi:MaterialIcon Kind="RobotOutline" Width="32" Height="32" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="EduAI Asistanınız Hazır" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Text="Sağ alttaki butondan ulaşabilirsiniz." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <views:LoadingOverlay Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
