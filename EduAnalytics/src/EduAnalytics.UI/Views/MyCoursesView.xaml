<UserControl x:Class="EduAnalytics.UI.Views.MyCoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource BackgroundBrush}">

    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Derslerim ve Öğrenciler" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Course List -->
            <Border Style="{StaticResource BentoCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Aktif Dersleriniz" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Courses}" 
                             SelectedItem="{Binding SelectedCourse, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding CourseName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CourseCode}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding EnrolledStudentCount, StringFormat='\{0\} Öğrenci'}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Course Stats -->
                <UniformGrid Columns="3" Margin="0,0,0,0" Visibility="{Binding IsCourseSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource BentoCardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <mi:MaterialIcon Kind="AccountGroup" Width="24" Height="24" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Text="Toplam Öğrenci" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedCourse.EnrolledStudentCount}" FontWeight="Bold" FontSize="24" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource BentoCardStyle}" Margin="4,0,4,0">
                        <StackPanel>
                            <mi:MaterialIcon Kind="BookOpenPageVariant" Width="24" Height="24" Foreground="#10B981" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Text="Konu / Müfredat" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedCourse.TopicCount}" FontWeight="Bold" FontSize="24" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource BentoCardStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <mi:MaterialIcon Kind="HelpCircleOutline" Width="24" Height="24" Foreground="#F59E0B" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Text="Soru Havuzu" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedCourse.QuestionCount}" FontWeight="Bold" FontSize="24" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Enrolled Students List -->
                <Border Grid.Row="2" Style="{StaticResource BentoCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedCourse.CourseName, FallbackValue='Ders Seçin'}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text=" sınıf listesi" FontWeight="Regular" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding SelectedCourse.EnrolledStudents}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowBackground="Transparent">
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding InspectStudentCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Öğrenci No" Binding="{Binding StudentNumber}" Width="120"/>
                                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Sınıf/Şube" Binding="{Binding ClassName}" Width="150"/>
                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="İncele"
                                                    Command="{Binding DataContext.InspectStudentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="12,4"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
