<UserControl x:Class="EduAnalytics.UI.Views.ExamCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:ctl="clr-namespace:EduAnalytics.UI.Controls"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             d:DataContext="{d:DesignInstance Type=vm:ExamCalendarViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="CalendarDaySurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter Property="Opacity" Value="0.42"/>
                    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasExams}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource ClickableCardHoverBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CalendarExamPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ctl:PageHeader Grid.Row="0"
                        Icon="CalendarClock"
                        Title="Sınav Takvimi"
                        Subtitle="Sınavları aylık görünümde izleyin ve seçili güne ait detaylara hızlıca geçin."/>

        <Border Grid.Row="1"
                Style="{StaticResource AlertErrorStyle}"
                Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerEmphasisBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="2" Style="{StaticResource PageScrollViewerStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource BentoCardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding MonthTitle}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0">
                                    <Run Text="{Binding Exams.Count, Mode=OneWay}"/>
                                    <Run Text=" sınav kayıtlı"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding PreviousMonthCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Önceki ay"
                                        Padding="11,9"
                                        Margin="0,0,8,0">
                                    <mi:MaterialIcon Kind="ChevronLeft" Width="18" Height="18"/>
                                </Button>
                                <Button Content="Bugün"
                                        Command="{Binding GoTodayCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14,9"
                                        Margin="0,0,8,0"/>
                                <Button Command="{Binding NextMonthCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Sonraki ay"
                                        Padding="11,9">
                                    <mi:MaterialIcon Kind="ChevronRight" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekdayNames}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" Rows="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="0"
                                            Margin="4"
                                            MinHeight="104"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch">
                                        <Border Style="{StaticResource CalendarDaySurfaceStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid>
                                                    <TextBlock Text="{Binding DayNumber}"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border HorizontalAlignment="Right"
                                                            Background="{DynamicResource PrimaryBrush}"
                                                            CornerRadius="7"
                                                            Padding="6,2"
                                                            Visibility="{Binding Exams.Count, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding Exams.Count, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </Grid>

                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding PreviewExams}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource CalendarExamPillStyle}">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding OverflowText}"
                                                           Visibility="{Binding HasMoreExams, Converter={StaticResource BoolToVisibility}}"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,5,0,0"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource BentoCardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Seçili Gün"
                                       Style="{StaticResource BentoLabelStyle}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding SelectedDateTitle}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0">
                                <Run Text="{Binding SelectedDayExams.Count, Mode=OneWay}"/>
                                <Run Text=" sınav"/>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,12"
                                Visibility="{Binding HasSelectedDayExams, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <StackPanel HorizontalAlignment="Center" Margin="0,16">
                                <mi:MaterialIcon Kind="CalendarBlankOutline"
                                                 Width="34"
                                                 Height="34"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource SubtleBrush}"/>
                                <TextBlock Text="Bu günde sınav yok"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding SelectedDayExams}"
                                      Visibility="{Binding HasSelectedDayExams, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardSubtleBgBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"/>

                                            <WrapPanel Grid.Row="1" Margin="0,10,0,12">
                                                <Border Background="{DynamicResource PrimaryLightBrush}"
                                                        CornerRadius="8"
                                                        Padding="8,4"
                                                        Margin="0,0,7,6">
                                                    <TextBlock Text="{Binding CourseName}"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="8,4"
                                                        Margin="0,0,7,6">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding TotalQuestions}"/>
                                                        <Run Text=" soru"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="8,4"
                                                        Margin="0,0,7,6">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding DurationMinutes}"/>
                                                        <Run Text=" dk"/>
                                                    </TextBlock>
                                                </Border>
                                            </WrapPanel>

                                            <Button Grid.Row="2"
                                                    Content="Detaya Git"
                                                    Command="{Binding DataContext.OpenExamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="14,9"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <views:LoadingOverlay Grid.RowSpan="3"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
