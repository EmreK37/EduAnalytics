<UserControl x:Class="EduAnalytics.UI.Views.ExamFromBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:ctl="clr-namespace:EduAnalytics.UI.Controls"
             xmlns:enums="clr-namespace:EduAnalytics.Core.Enums;assembly=EduAnalytics.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=vm:ExamFromBankViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="ChipStyle" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="ChipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MiniButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="PointInputStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="72"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource PageRootGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ctl:PageHeader Grid.Row="0"
                            Icon="ClipboardListOutline"
                            Title="Sınav Oluştur"
                            Subtitle="Yeni soru üretmek yerine soru bankasındaki aktif soruları seçerek hızlıca sınav kurun. Vize tipinde sadece tarihe kadar olan ÖÇ'ler kullanılabilir."/>

            <Border Grid.Row="1" Style="{StaticResource FormFlowPanelStyle}">
                <UniformGrid Columns="4">
                    <StackPanel Style="{StaticResource FormFlowStepStyle}">
                        <Border Style="{StaticResource FormFlowNumberStyle}">
                            <TextBlock Text="1" Style="{StaticResource FormFlowNumberTextStyle}"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Sınav bilgileri" Style="{StaticResource FormFlowTitleStyle}"/>
                            <TextBlock Text="Ders, tip ve kitapçık" Style="{StaticResource FormFlowCaptionStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FormFlowStepStyle}">
                        <Border Style="{StaticResource FormFlowNumberStyle}">
                            <TextBlock Text="2" Style="{StaticResource FormFlowNumberTextStyle}"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Öğrenciler" Style="{StaticResource FormFlowTitleStyle}"/>
                            <TextBlock Text="Sınıf ve katılım kapsamı" Style="{StaticResource FormFlowCaptionStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FormFlowStepStyle}">
                        <Border Style="{StaticResource FormFlowNumberStyle}">
                            <TextBlock Text="3" Style="{StaticResource FormFlowNumberTextStyle}"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Soru havuzu" Style="{StaticResource FormFlowTitleStyle}"/>
                            <TextBlock Text="Ara, incele ve seç" Style="{StaticResource FormFlowCaptionStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FormFlowStepStyle}" Margin="0">
                        <Border Style="{StaticResource FormFlowNumberStyle}">
                            <TextBlock Text="4" Style="{StaticResource FormFlowNumberTextStyle}"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Denge" Style="{StaticResource FormFlowTitleStyle}"/>
                            <TextBlock Text="100 puan ve dağılım kontrolü" Style="{StaticResource FormFlowCaptionStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Sınav bilgi paneli -->
            <Border Grid.Row="2" Style="{StaticResource BentoCardStyle}">
                <StackPanel>
                    <TextBlock Text="Sınav Bilgileri" Style="{StaticResource SubheadingStyle}"/>
                    <TextBlock Text="Önce sınavın temel kimliğini ve katılımcı kapsamını belirleyin; soru havuzu bu seçimlere göre daha anlamlı filtrelenir."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,-8,0,14"
                               TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="235"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ders" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Sınav Başlığı" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Tarih" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Süre (dk)" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="8" Text="Tip" Style="{StaticResource LabelStyle}"/>

                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding Courses}"
                                  SelectedItem="{Binding SelectedCourse}"
                                  DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{Binding CourseError}"
                                   Style="{StaticResource FormErrorTextStyle}"
                                   Visibility="{Binding CourseError, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBox Grid.Row="1" Grid.Column="2"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   Text="{Binding TitleError}"
                                   Style="{StaticResource FormErrorTextStyle}"
                                   Visibility="{Binding TitleError, Converter={StaticResource BoolToVisibility}}"/>
                        <DatePicker Grid.Row="1" Grid.Column="4"
                                    SelectedDate="{Binding ExamDate}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1" Grid.Column="6"
                                 Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch"
                                 Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="6"
                                   Text="{Binding DurationMinutesError}"
                                   Style="{StaticResource FormErrorTextStyle}"
                                   Visibility="{Binding DurationMinutesError, Converter={StaticResource BoolToVisibility}}"/>
                        <ComboBox Grid.Row="1" Grid.Column="8"
                                  SelectedItem="{Binding ExamType}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,4">
                            <ComboBox.Items>
                                <x:Static Member="enums:ExamType.Quiz"/>
                                <x:Static Member="enums:ExamType.Midterm"/>
                                <x:Static Member="enums:ExamType.Final"/>
                                <x:Static Member="enums:ExamType.MakeUp"/>
                            </ComboBox.Items>
                        </ComboBox>
                    </Grid>

                    <!-- Kitapçık ayarları -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Kitapçık Sayısı"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="2"
                                  SelectedItem="{Binding BookletCount}"
                                  Width="80" VerticalAlignment="Center">
                            <ComboBox.Items>
                                <sys:Int32>1</sys:Int32>
                                <sys:Int32>2</sys:Int32>
                                <sys:Int32>3</sys:Int32>
                                <sys:Int32>4</sys:Int32>
                            </ComboBox.Items>
                        </ComboBox>

                        <CheckBox Grid.Column="4"
                                  IsChecked="{Binding ShuffleOptions}"
                                  Content="Şıkları karıştır"
                                  VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="20,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Birden fazla kitapçıkta sorular farklı sırayla çıkar. 'Şıkları karıştır' seçilirse B/C/D kitapçıklarında şıklar da permüte edilir."/>
                    </Grid>

                    <!-- Öğrenci seçimi -->
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,18,0,0"
                            Padding="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Sınava Girecek Öğrenciler" Style="{StaticResource SubheadingStyle}"/>
                            <TextBlock Text="Birden fazla bölüm/sınıf seçebilirsiniz (alttan alan, yükseltme veya ortak ders öğrencileri)."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,-8,0,12"/>

                            <TextBlock Text="Sınıf / Bölüm Filtresi" Style="{StaticResource LabelStyle}"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusLg}"
                                    MaxHeight="100"
                                    Background="{DynamicResource PageBgBrush}"
                                    Margin="0,0,0,10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                    <ItemsControl ItemsSource="{Binding ClassFilters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding ClassName}"
                                                          IsChecked="{Binding IsSelected}"
                                                          Margin="6,4"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Tüm Sınıfları Seç"
                                        Command="{Binding SelectAllClassesCommand}"
                                        Style="{StaticResource MiniButtonStyle}"/>
                                <Button Content="Sınıf Filtresini Temizle"
                                        Command="{Binding ClearClassFilterCommand}"
                                        Style="{StaticResource MiniButtonStyle}"/>
                                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,2,12,2"/>
                                <Button Content="Filtredeki Tüm Öğrencileri Seç"
                                        Command="{Binding SelectAllFilteredCommand}"
                                        Style="{StaticResource MiniButtonStyle}"/>
                                <Button Content="Öğrenci Seçimini Temizle"
                                        Command="{Binding DeselectAllFilteredCommand}"
                                        Style="{StaticResource MiniButtonStyle}"/>
                            </StackPanel>

                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusLg}"
                                    Height="220"
                                    Background="{DynamicResource CardBgBrush}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                    <ItemsControl ItemsSource="{Binding FilteredStudents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="8,5">
                                                    <TextBlock FontSize="13">
                                                        <Run Text="{Binding StudentNumber}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                        <Run Text="  ·  "/>
                                                        <Run Text="{Binding FullName}"/>
                                                        <Run Text="  ("/><Run Text="{Binding ClassName}" Foreground="{DynamicResource TextSecondaryBrush}"/><Run Text=")"/>
                                                    </TextBlock>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- İki kolonlu havuz vs. seçili sorular -->
            <Grid Grid.Row="3" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: havuz -->
                <Border Grid.Column="0" Style="{StaticResource BentoCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Soru Havuzu" Style="{StaticResource SubheadingStyle}"/>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding PoolQuestionTypeFilters}"
                                      SelectedItem="{Binding SelectedPoolQuestionTypeFilter, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      MinHeight="44"/>

                            <TextBox Grid.Column="2"
                                     Text="{Binding BankSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="4"
                                    Content="Ara"
                                    Command="{Binding SearchPoolCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="70"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding BankPool}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource RadiusLg}"
                                                    Padding="12"
                                                    Margin="0,0,0,8"
                                                    Background="{DynamicResource CardBgBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding QuestionText}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Border Style="{StaticResource ChipStyle}">
                                                                <TextBlock Text="{Binding Type}" Style="{StaticResource ChipTextStyle}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource ChipStyle}">
                                                                <TextBlock Style="{StaticResource ChipTextStyle}">
                                                                    <Run Text="{Binding MaxPoints}"/>
                                                                    <Run Text=" puan"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Detay"
                                                                Command="{Binding DataContext.ShowQuestionDetailCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="10,5"
                                                                FontSize="11"
                                                                Margin="6,0,0,0"/>
                                                        <Button Content="Ekle"
                                                                Command="{Binding DataContext.AddToExamCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Padding="14,5"
                                                                FontSize="11"
                                                                Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Soru Detay Paneli -->
                                <Border BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusLg}"
                                        Padding="14"
                                        Margin="0,4,0,0"
                                        Background="{DynamicResource PrimaryLightBrush}"
                                        Visibility="{Binding DetailQuestionModel, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Soru Detayı"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource PrimaryDarkBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Content="Kapat"
                                                    Command="{Binding CloseQuestionDetailCommand}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Padding="8,4"
                                                    FontSize="11"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Style="{StaticResource ChipStyle}" Background="{DynamicResource CardBgBrush}">
                                                <TextBlock Text="{Binding DetailQuestionModel.Type}" Style="{StaticResource ChipTextStyle}"/>
                                            </Border>
                                            <Border Style="{StaticResource ChipStyle}" Background="{DynamicResource CardBgBrush}">
                                                <TextBlock Style="{StaticResource ChipTextStyle}">
                                                    <Run Text="{Binding DetailQuestionModel.MaxPoints}"/>
                                                    <Run Text=" puan"/>
                                                </TextBlock>
                                            </Border>
                                            <Border Style="{StaticResource ChipStyle}"
                                                    Background="{DynamicResource SuccessSubtleBgBrush}"
                                                    BorderBrush="{DynamicResource SuccessBrush}">
                                                <TextBlock Style="{StaticResource ChipTextStyle}" Foreground="{DynamicResource SuccessEmphasisBrush}">
                                                    <Run Text="Doğru: "/>
                                                    <Run Text="{Binding DetailQuestionModel.CorrectOption}"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding DetailQuestionModel.QuestionText}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="A" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailQuestionModel.OptionA}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="B" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailQuestionModel.OptionB}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="C" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailQuestionModel.OptionC}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="D" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailQuestionModel.OptionD}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="E" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailQuestionModel.OptionE}" TextWrapping="Wrap"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding DetailQuestion.LearningOutcomeCodes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBgBrush}"
                                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource RadiusLg}"
                                                            Padding="6,2"
                                                            Margin="0,0,4,4">
                                                        <TextBlock Text="{Binding}"
                                                                   Foreground="{DynamicResource PrimaryDarkBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Sağ: seçili sorular -->
                <Border Grid.Column="2" Style="{StaticResource BentoCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource SubheadingStyle}" Margin="0">
                                <Run Text="Seçilen Sorular ("/>
                                <Run Text="{Binding SelectedQuestions.Count, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedQuestionsPointSummary}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <Button Content="100 Puana Eşitle"
                                        Command="{Binding DistributePointsTo100Command}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,5"
                                        FontSize="11"
                                        ToolTip="Toplam puanı 100 olacak şekilde tüm seçili sorulara eşit dağıtır."/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding SelectedQuestionsError}"
                                   Style="{StaticResource FormErrorTextStyle}"
                                   Visibility="{Binding SelectedQuestionsError, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,-4,0,10"/>

                        <Border Grid.Row="2"
                                Style="{StaticResource AlertInfoStyle}"
                                Margin="0,0,0,10"
                                Visibility="{Binding BalancePreview, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource PrimaryDarkBrush}" FontSize="12">
                                    <Run Text="Denge Skoru: "/>
                                    <Run Text="{Binding BalancePreview.BalanceScore, FallbackValue='—'}" FontWeight="Bold"/>
                                    <Run Text=" / 100"/>
                                </TextBlock>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding BalancePreview.Warnings.Count, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="{Binding BalancePreview.Warnings.Count}"/>
                                    <Run Text=" uyarı var — Sınav Dengesi sekmesinden inceleyin."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedQuestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusLg}"
                                                Padding="12"
                                                Margin="0,0,0,8"
                                                Background="{DynamicResource PrimaryLightBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding QuestionText}"
                                                               TextWrapping="Wrap"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Border Style="{StaticResource ChipStyle}" Background="{DynamicResource CardBgBrush}">
                                                            <TextBlock Text="{Binding Type}" Style="{StaticResource ChipTextStyle}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource ChipStyle}" Background="{DynamicResource CardBgBrush}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Puan"
                                                                           Style="{StaticResource ChipTextStyle}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"/>
                                                                <TextBox Text="{Binding MaxPoints, Mode=OneWay, StringFormat={}{0:0.##}}"
                                                                         Style="{StaticResource PointInputStyle}"
                                                                         LostFocus="SelectedQuestionPoints_LostFocus"
                                                                         KeyDown="SelectedQuestionPoints_KeyDown"
                                                                         ToolTip="Bu sorunun sınav puanını girin. Toplam en fazla 100 puan olabilir."/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="↑"
                                                            Command="{Binding DataContext.MoveUpCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="8,4"
                                                            FontSize="12"
                                                            Margin="0,0,4,0"/>
                                                    <Button Content="↓"
                                                            Command="{Binding DataContext.MoveDownCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="8,4"
                                                            FontSize="12"
                                                            Margin="0,0,4,0"/>
                                                    <Button Content="Çıkar"
                                                            Command="{Binding DataContext.RemoveFromExamCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Padding="10,4"
                                                            FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Alt bar -->
            <Border Grid.Row="4"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,14,0,0"
                    Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Style="{StaticResource AlertErrorStyle}"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource DangerEmphasisBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <Border Style="{StaticResource AlertSuccessStyle}"
                                Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SuccessMessage}"
                                       Foreground="{DynamicResource SuccessEmphasisBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Sınavı Oluştur"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="28,12"
                            FontSize="14"
                            Margin="20,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
