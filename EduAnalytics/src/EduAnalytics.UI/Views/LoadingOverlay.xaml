<UserControl x:Class="EduAnalytics.UI.Views.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="{DynamicResource OverlayBrush}"
             IsHitTestVisible="True">
    <UserControl.Resources>
        <Storyboard x:Key="SpinAnim" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="SpinnerArc"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                From="0" To="360" Duration="0:0:0.9"/>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SpinAnim}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="42" Height="42">
            <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="3" Opacity="0.5"/>
            <Ellipse x:Name="SpinnerArc"
                     Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="3"
                     StrokeDashArray="5 8"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
        <TextBlock Text="{Binding Message, ElementName=Root}"
                   Margin="0,14,0,0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TooltipFgBrush}"
                   HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
