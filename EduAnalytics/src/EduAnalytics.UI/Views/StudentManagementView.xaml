<UserControl x:Class="EduAnalytics.UI.Views.StudentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:ctl="clr-namespace:EduAnalytics.UI.Controls"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             d:DataContext="{d:DesignInstance Type=vm:StudentManagementViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ctl:PageHeader Grid.Row="0"
                        Icon="AccountGroup"
                        Title="Öğrenci Yönetimi"
                        Subtitle="Sistemde kayıtlı öğrencileri görüntüleyin, ekleyin, güncelleyin veya silin. Toplu yükleme için şablonu indirin, doldurun ve sisteme yükleyin.">
            <ctl:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                <Button Content="Şablon İndir"
                        Command="{Binding DownloadTemplateCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        ToolTip="Boş Excel şablonunu indir"/>
                <Button Content="Excel'den Yükle"
                        Command="{Binding ImportExcelCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Doldurulmuş Excel'i sisteme yükle"/>
                </StackPanel>
            </ctl:PageHeader.Actions>
        </ctl:PageHeader>

        <!-- Mesajlar -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Style="{StaticResource AlertErrorStyle}"
                    Margin="0,0,0,6"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerEmphasisBrush}" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource AlertSuccessStyle}"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessEmphasisBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Form -->
        <Border Grid.Row="2" Style="{StaticResource BentoCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SubheadingStyle}">
                    <Run Text="{Binding EditingStudent.StudentNumber, FallbackValue='Yeni Öğrenci'}"/>
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Öğrenci No" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Ad Soyad" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Sınıf / Bölüm" Style="{StaticResource LabelStyle}"/>

                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding FormStudentNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Row="1" Grid.Column="2"
                             Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Row="1" Grid.Column="4"
                             Text="{Binding FormClassName, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Grid.Row="1" Grid.Column="6" Orientation="Horizontal">
                        <Button Content="Kaydet"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,6,0"/>
                        <Button Content="Temizle"
                                Command="{Binding StartNewCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Liste + arama -->
        <Border Grid.Row="3" Style="{StaticResource BentoCardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Numara, ad-soyad veya sınıf adında ara"/>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="Toplam: "/>
                        <Run Text="{Binding FilteredStudents.Count, Mode=OneWay}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </TextBlock>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredStudents}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Numara" Binding="{Binding StudentNumber}" Width="120"/>
                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*" MinWidth="220"/>
                        <DataGridTextColumn Header="Sınıf / Bölüm" Binding="{Binding ClassName}" Width="220"/>
                        <DataGridTextColumn Header="Kayıtlı Ders" Binding="{Binding EnrolledCourseCount}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Düzenle"
                                                Command="{Binding DataContext.StartEditCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="10,4"
                                                FontSize="11"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Sil"
                                                Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="10,4"
                                                FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1"
                            Style="{StaticResource EmptyStateStyle}"
                            Visibility="{Binding FilteredStudents.Count, Converter={StaticResource CollectionEmptyToVisibility}}">
                    <mi:MaterialIcon Kind="AccountGroupOutline" Width="48" Height="48"
                                     Foreground="{DynamicResource SubtleBrush}"
                                     HorizontalAlignment="Center"/>
                    <TextBlock Text="Öğrenci bulunamadı" Style="{StaticResource EmptyStateTitleStyle}"/>
                    <TextBlock Text="Yukarıdaki formu kullanarak yeni öğrenci ekleyin veya Excel ile toplu yükleyin."
                               Style="{StaticResource EmptyStateDescriptionStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <views:LoadingOverlay Grid.Row="0" Grid.RowSpan="4"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
