<UserControl x:Class="EduAnalytics.UI.Views.QuestionBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:ctl="clr-namespace:EduAnalytics.UI.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             d:DataContext="{d:DesignInstance Type=vm:QuestionBankViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ctl:PageHeader Grid.Row="0"
                        Icon="HelpBoxMultipleOutline"
                        Title="Soru Bankası"
                        Subtitle="Ders bazlı soru havuzunu yönetin. Aktif sorular sınav oluşturma akışında kullanılabilir.">
            <ctl:PageHeader.Actions>
                <Button Command="{Binding NavigateToCreateQuestionCommand}"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <mi:MaterialIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Soru Ekle" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ctl:PageHeader.Actions>
        </ctl:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource BentoCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.9*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,16">
                    <TextBlock Text="Ders" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Courses}"
                              SelectedItem="{Binding SelectedCourse}"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                    <TextBlock Text="Soru metninde ara" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <TextBlock Text="Tip" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox SelectedItem="{Binding TypeFilter}" Width="148" Margin="0,0,18,0">
                        <sys:String>Tümü</sys:String>
                        <sys:String>Test</sys:String>
                        <sys:String>Klasik</sys:String>
                    </ComboBox>

                    <TextBlock Text="Durum" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox SelectedItem="{Binding FilterStatus}" Width="148" Margin="0,0,18,0">
                        <sys:String>Tümü</sys:String>
                        <sys:String>Aktif</sys:String>
                        <sys:String>Pasif</sys:String>
                    </ComboBox>

                    <CheckBox Content="Sadece favoriler"
                              IsChecked="{Binding FilterFavoriteOnly}"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Border Style="{StaticResource AlertErrorStyle}"
                        Margin="0,0,0,8"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerEmphasisBrush}" TextWrapping="Wrap"/>
                </Border>
                <Border Style="{StaticResource AlertSuccessStyle}"
                        Margin="0,0,0,8"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessEmphasisBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <ScrollViewer Style="{StaticResource PageScrollViewerStyle}" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BentoCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Command="{Binding DataContext.ToggleFavoriteCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Cursor="Hand"
                                            VerticalAlignment="Top">
                                        <TextBlock FontSize="20">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="☆"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Text" Value="★"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <StackPanel Grid.Column="1" Margin="4,0,18,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="{DynamicResource RadiusLg}" Padding="7,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Type}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="{DynamicResource PageBgBrush}" CornerRadius="{DynamicResource RadiusLg}" Padding="7,3" Margin="0,0,6,0">
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding MaxPoints}"/>
                                                    <Run Text=" puan"/>
                                                </TextBlock>
                                            </Border>
                                            <Border Background="{DynamicResource WarningSubtleBgBrush}"
                                                    BorderBrush="{DynamicResource WarningSubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource RadiusLg}"
                                                    Padding="7,3"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding UsedInExamCount, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningSubtleTextBrush}">
                                                    <Run Text="{Binding UsedInExamCount}"/>
                                                    <Run Text=" sınavda kullanıldı"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding QuestionText}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="14"
                                                   Margin="0,0,0,8"/>

                                        <ItemsControl ItemsSource="{Binding UsedInExamTitles}"
                                                      Visibility="{Binding UsedInExamCount, Converter={StaticResource BoolToVisibility}}"
                                                      Margin="0,0,0,6">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource WarningSubtleBgBrush}"
                                                            BorderBrush="{DynamicResource WarningSubtleBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource RadiusLg}"
                                                            Padding="7,3"
                                                            Margin="0,0,5,5">
                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource WarningSubtleTextBrush}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding LearningOutcomeCodes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource PrimaryLightBrush}"
                                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource RadiusLg}"
                                                            Padding="6,3"
                                                            Margin="0,0,5,4">
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource PrimaryDarkBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Command="{Binding DataContext.ToggleActiveCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0"
                                                Padding="6,11"
                                                BorderThickness="1">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Content" Value="Pasif"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Content" Value="Aktif"/>
                                                            <Setter Property="Background" Value="{DynamicResource SuccessSubtleBgBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessSubtleBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="Düzenle"
                                                Command="{Binding DataContext.EditCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="11,6"
                                                Margin="0,0,6,0"/>

                                        <Button Content="Sil"
                                                Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="11,6"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="1"
                        Style="{StaticResource EmptyStateStyle}"
                        Visibility="{Binding Questions.Count, Converter={StaticResource CollectionEmptyToVisibility}}">
                <mi:MaterialIcon Kind="InboxOutline" Width="48" Height="48"
                                 Foreground="{DynamicResource SubtleBrush}"
                                 HorizontalAlignment="Center"/>
                <TextBlock Text="Soru bulunamadı" Style="{StaticResource EmptyStateTitleStyle}"/>
                <TextBlock Text="Filtreleri değiştirin veya yeni soru ekleyin."
                           Style="{StaticResource EmptyStateDescriptionStyle}"/>
            </StackPanel>
        </Grid>

        <views:LoadingOverlay Grid.RowSpan="3"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
