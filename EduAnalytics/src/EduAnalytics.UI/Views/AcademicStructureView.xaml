<UserControl x:Class="EduAnalytics.UI.Views.AcademicStructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:ctl="clr-namespace:EduAnalytics.UI.Controls"
             d:DataContext="{d:DesignInstance Type=vm:AcademicStructureViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="AcademicListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusLg}"
                                Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ClickableCardHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ctl:PageHeader Grid.Row="0"
                        Icon="School"
                        Title="Akademik Yapı Yönetimi"
                        Subtitle="Programları ve dersleri buradan yönetin. Bağımlı kayıt (PÇ, ÖÇ, soru, sınav) varsa silme engellenir."/>

        <!-- Mesajlar -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Style="{StaticResource AlertErrorStyle}"
                    Margin="0,0,0,6"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerEmphasisBrush}" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource AlertSuccessStyle}"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessEmphasisBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- 2 KOLON -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- KOLON 1: PROGRAMLAR -->
            <Border Grid.Column="0" Style="{StaticResource BentoCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Programlar" Style="{StaticResource SubheadingStyle}"/>

                    <Border Grid.Row="1"
                            Style="{StaticResource CardSubtleStyle}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,8">
                                <Run Text="{Binding EditingProgram.Code, FallbackValue='Yeni Program'}"/>
                            </TextBlock>

                            <TextBlock Text="Kod" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ProgramFormCode, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Text="Ad" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ProgramFormName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Text="Açıklama" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ProgramFormDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="44"
                                     VerticalContentAlignment="Top"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Kaydet"
                                        Command="{Binding SaveProgramCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="14,6"
                                        FontSize="12"
                                        Margin="0,0,6,0"/>
                                <Button Content="Temizle"
                                        Command="{Binding StartNewProgramCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Programs}"
                             SelectedItem="{Binding SelectedProgram}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource AcademicListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource PrimaryBrush}"
                                                    CornerRadius="{DynamicResource RadiusLg}"
                                                    Padding="6,2"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Code}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0">
                                            <Run Text="{Binding CourseCount}"/>
                                            <Run Text=" ders · "/>
                                            <Run Text="{Binding OutcomeCount}"/>
                                            <Run Text=" PÇ"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Düzenle"
                                                Command="{Binding DataContext.StartEditProgramCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Padding="8,4"
                                                FontSize="11"/>
                                        <Button Content="Sil"
                                                Command="{Binding DataContext.DeleteProgramCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Padding="8,4"
                                                FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- KOLON 2: DERSLER -->
            <Border Grid.Column="2" Style="{StaticResource BentoCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Dersler" Style="{StaticResource SubheadingStyle}" Margin="0"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding SelectedProgram.Name, FallbackValue='— program seçin —'}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,12"/>

                    <Border Grid.Row="2"
                            Style="{StaticResource CardSubtleStyle}"
                            Margin="0,0,0,12"
                            IsEnabled="{Binding SelectedProgram, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,8">
                                <Run Text="{Binding EditingCourse.Code, FallbackValue='Yeni Ders'}"/>
                            </TextBlock>

                            <TextBlock Text="Kod" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding CourseFormCode, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Text="Ad" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding CourseFormName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Text="Açıklama" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding CourseFormDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="44"
                                     VerticalContentAlignment="Top"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Kaydet"
                                        Command="{Binding SaveCourseCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="14,6"
                                        FontSize="12"
                                        Margin="0,0,6,0"/>
                                <Button Content="Temizle"
                                        Command="{Binding StartNewCourseCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding Courses}"
                             SelectedItem="{Binding SelectedCourse}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource AcademicListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource SuccessBrush}"
                                                    CornerRadius="{DynamicResource RadiusLg}"
                                                    Padding="6,2"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Code}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0">
                                            <Run Text="{Binding TopicCount}"/>
                                            <Run Text=" konu · "/>
                                            <Run Text="{Binding LearningOutcomeCount}"/>
                                            <Run Text=" ÖÇ · "/>
                                            <Run Text="{Binding QuestionCount}"/>
                                            <Run Text=" soru · "/>
                                            <Run Text="{Binding ExamCount}"/>
                                            <Run Text=" sınav"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Düzenle"
                                                Command="{Binding DataContext.StartEditCourseCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Padding="8,4"
                                                FontSize="11"/>
                                        <Button Content="Sil"
                                                Command="{Binding DataContext.DeleteCourseCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Padding="8,4"
                                                FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <views:LoadingOverlay Grid.Row="0" Grid.RowSpan="3"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
