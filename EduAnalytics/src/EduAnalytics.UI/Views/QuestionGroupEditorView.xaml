<UserControl x:Class="EduAnalytics.UI.Views.QuestionGroupEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:ctl="clr-namespace:EduAnalytics.UI.Controls"
             xmlns:enums="clr-namespace:EduAnalytics.Core.Enums;assembly=EduAnalytics.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=vm:QuestionGroupEditorViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="QuestionTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:QuestionType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="OptionLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctl:PageHeader Grid.Row="0"
                        Icon="HelpBoxMultipleOutline"
                        Title="İlişkili Soru (Common-Stem) Editörü"
                        Subtitle="Tek bir gövde (tablo, paragraf, vaka, şema) yazın, ardından bu gövdeye bağlı 2 veya daha fazla alt soru ekleyin. Sorular soru bankasına bu grup altında kaydedilir; sınav oluştururken birlikte seçilebilir."/>

        <ScrollViewer Style="{StaticResource PageScrollViewerStyle}" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <Border Style="{StaticResource FormFlowPanelStyle}">
                    <UniformGrid Columns="4">
                        <StackPanel Style="{StaticResource FormFlowStepStyle}">
                            <Border Style="{StaticResource FormFlowNumberStyle}">
                                <TextBlock Text="1" Style="{StaticResource FormFlowNumberTextStyle}"/>
                            </Border>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Gövde" Style="{StaticResource FormFlowTitleStyle}"/>
                                <TextBlock Text="Ders, metin ve görsel" Style="{StaticResource FormFlowCaptionStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FormFlowStepStyle}">
                            <Border Style="{StaticResource FormFlowNumberStyle}">
                                <TextBlock Text="2" Style="{StaticResource FormFlowNumberTextStyle}"/>
                            </Border>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Alt sorular" Style="{StaticResource FormFlowTitleStyle}"/>
                                <TextBlock Text="En az 2 soru ekle" Style="{StaticResource FormFlowCaptionStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FormFlowStepStyle}">
                            <Border Style="{StaticResource FormFlowNumberStyle}">
                                <TextBlock Text="3" Style="{StaticResource FormFlowNumberTextStyle}"/>
                            </Border>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Konu ve ÖÇ" Style="{StaticResource FormFlowTitleStyle}"/>
                                <TextBlock Text="Her alt soruyu eşleştir" Style="{StaticResource FormFlowCaptionStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FormFlowStepStyle}" Margin="0">
                            <Border Style="{StaticResource FormFlowNumberStyle}">
                                <TextBlock Text="4" Style="{StaticResource FormFlowNumberTextStyle}"/>
                            </Border>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Kaydet" Style="{StaticResource FormFlowTitleStyle}"/>
                                <TextBlock Text="Grubu bankaya ekle" Style="{StaticResource FormFlowCaptionStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Ders + Gövde -->
                <Border Style="{StaticResource BentoCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Ders ve Gövde" Style="{StaticResource SubheadingStyle}"/>
                        <TextBlock Text="Ortak gövde tüm alt soruların referansıdır; tablo, vaka ya da şema gibi paylaşılan bilgiyi burada net tutun."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,-8,0,14"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Ders" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Courses}"
                                  SelectedItem="{Binding SelectedCourse}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CourseError}"
                                   Style="{StaticResource FormErrorTextStyle}"
                                   Visibility="{Binding CourseError, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Gövde Metni" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="Paragraf, tablo, vaka açıklaması — alt soruların ortak referansı."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,-4,0,4"/>
                        <TextBox Text="{Binding StemText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 VerticalContentAlignment="Top"
                                 FontFamily="Geist Mono, JetBrains Mono, Consolas, Menlo, monospace"
                                 FontSize="13"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StemTextError}"
                                   Style="{StaticResource FormErrorTextStyle}"
                                   Visibility="{Binding StemTextError, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Görsel / Şema (opsiyonel)" Style="{StaticResource LabelStyle}" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding MediaPath}"
                                     IsReadOnly="True"
                                     Background="{DynamicResource PageBgBrush}"/>
                            <Button Grid.Column="1"
                                    Content="Dosya Seç"
                                    Command="{Binding BrowseMediaCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0"/>
                            <Button Grid.Column="2"
                                    Content="Temizle"
                                    Command="{Binding ClearMediaCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="12,6"
                                    Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Alt sorular -->
                <Border Style="{StaticResource BentoCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Alt Sorular" Style="{StaticResource SubheadingStyle}" Margin="0"/>
                            <Button Grid.Column="1"
                                    Content="Alt Soru Ekle"
                                    Command="{Binding AddSubQuestionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>

                        <Border Style="{StaticResource CardSubtleStyle}" Margin="0,12,0,12">
                            <TextBlock Text="Her alt soru kendi puanı, doğru yanıtı, konusu ve öğrenim çıktısı bağlantısıyla ayrı değerlendirilebilir."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="{Binding SubQuestionsError}"
                                   Style="{StaticResource FormErrorTextStyle}"
                                   Visibility="{Binding SubQuestionsError, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,-4,0,12"/>

                        <Border Style="{StaticResource AlertInfoStyle}"
                                Margin="0,0,0,12"
                                Visibility="{Binding SubQuestions.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock Foreground="{DynamicResource PrimaryDarkBrush}" FontSize="12">
                                Alt soru eklemek için yukarıdaki butona tıklayın. En az 2 alt soru gereklidir.
                            </TextBlock>
                        </Border>

                        <ItemsControl ItemsSource="{Binding SubQuestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusLg}"
                                            Padding="14"
                                            Margin="0,0,0,10"
                                            Background="{DynamicResource CardBgBrush}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           FontSize="14">
                                                    <Run Text="Alt Soru "/>
                                                    <Run Text="{Binding QuestionNumber}" Foreground="{DynamicResource PrimaryBrush}"/>
                                                </TextBlock>

                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding Source={StaticResource QuestionTypeValues}}"
                                                          SelectedItem="{Binding Type}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding}" Value="MultipleChoice">
                                                                                <Setter Property="Text" Value="Test"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="OpenEnded">
                                                                                <Setter Property="Text" Value="Klasik"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <TextBox Grid.Column="4"
                                                         Text="{Binding MaxPoints, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="80"/>

                                                <Button Grid.Column="6"
                                                        Content="Sil"
                                                        Command="{Binding DataContext.RemoveSubQuestionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="12,4"
                                                        FontSize="12"/>
                                            </Grid>
                                            <TextBlock Text="{Binding MaxPointsError}"
                                                       Style="{StaticResource FormErrorTextStyle}"
                                                       Visibility="{Binding MaxPointsError, Converter={StaticResource BoolToVisibility}}"
                                                       Margin="0,-4,0,10"/>

                                            <TextBlock Text="Soru Metni" Style="{StaticResource LabelStyle}"/>
                                            <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="56"
                                                     VerticalContentAlignment="Top"
                                                     Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding QuestionTextError}"
                                                       Style="{StaticResource FormErrorTextStyle}"
                                                       Visibility="{Binding QuestionTextError, Converter={StaticResource BoolToVisibility}}"/>

                                            <!-- Test ise şıklar -->
                                            <StackPanel Visibility="{Binding IsMultipleChoice, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Şıklar" Style="{StaticResource LabelStyle}" Margin="0,12,0,4"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="A" Style="{StaticResource OptionLabelStyle}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding OptionA, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Column="3" Text="B" Style="{StaticResource OptionLabelStyle}"/>
                                                    <TextBox Grid.Column="4" Text="{Binding OptionB, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="C" Style="{StaticResource OptionLabelStyle}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding OptionC, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Column="3" Text="D" Style="{StaticResource OptionLabelStyle}"/>
                                                    <TextBox Grid.Column="4" Text="{Binding OptionD, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="E" Style="{StaticResource OptionLabelStyle}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding OptionE, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding OptionsError}"
                                                           Style="{StaticResource FormErrorTextStyle}"
                                                           Visibility="{Binding OptionsError, Converter={StaticResource BoolToVisibility}}"
                                                           Margin="0,-6,0,10"/>

                                                <TextBlock Text="Doğru Şık" Style="{StaticResource LabelStyle}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="A" Margin="0,0,16,0" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=A}"/>
                                                    <RadioButton Content="B" Margin="0,0,16,0" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=B}"/>
                                                    <RadioButton Content="C" Margin="0,0,16,0" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=C}"/>
                                                    <RadioButton Content="D" Margin="0,0,16,0" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=D}"/>
                                                    <RadioButton Content="E" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=E}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Klasik ise cevap anahtarı -->
                                            <StackPanel Visibility="{Binding IsOpenEnded, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Cevap Anahtarı / Notlandırma" Style="{StaticResource LabelStyle}" Margin="0,12,0,4"/>
                                                <TextBox Text="{Binding AnswerKey, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MinHeight="56"
                                                         VerticalContentAlignment="Top"/>
                                            </StackPanel>

                                            <!-- Konu seçimi -->
                                            <TextBlock Text="Konu" Style="{StaticResource LabelStyle}" Margin="0,12,0,4"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding AvailableTopics}"
                                                          SelectedItem="{Binding TopicToAdd}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="H"/>
                                                                <TextBlock Text="{Binding WeekNumber}"/>
                                                                <TextBlock Text=" — "/>
                                                                <TextBlock Text="{Binding Title}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="1"
                                                        Content="Ekle"
                                                        Command="{Binding AddTopicCommand}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Padding="14,6"
                                                        FontSize="12"
                                                        Margin="6,0,0,0"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedTopics}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource PrimaryLightBrush}"
                                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{DynamicResource RadiusLg}"
                                                                Padding="6,3"
                                                                Margin="0,0,4,4">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Foreground="{DynamicResource PrimaryDarkBrush}" FontSize="11" FontWeight="SemiBold">
                                                                    <Run Text="H"/>
                                                                    <Run Text="{Binding WeekNumber}"/>
                                                                    <Run Text="  "/>
                                                                    <Run Text="{Binding Title}" FontWeight="Normal" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                </TextBlock>
                                                                <Button Content="✕"
                                                                        Command="{Binding DataContext.RemoveTopicCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GhostButtonStyle}"
                                                                        Foreground="{DynamicResource PrimaryDarkBrush}"
                                                                        Padding="4,0"
                                                                        FontSize="11"
                                                                        FontWeight="Bold"
                                                                        Margin="6,0,0,0"
                                                                        VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Alt çubuk -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Style="{StaticResource AlertErrorStyle}"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerEmphasisBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Style="{StaticResource AlertSuccessStyle}"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessEmphasisBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Common-Stem Grubu Kaydet"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="28,12"
                        FontSize="14"
                        Margin="20,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
