<Window x:Class="EduAnalytics.UI.Views.UserSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="Kullanıcı Ayarları"
        Icon="../Assets/AppIcon.ico"
        Width="860"
        Height="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBgBrush}"
        KeyDown="OnKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource PageBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TopBarBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <mi:MaterialIcon Kind="AccountCogOutline"
                                     Width="16"
                                     Height="16"
                                     Foreground="{DynamicResource PrimaryBrush}"
                                     VerticalAlignment="Center"/>
                    <TextBlock Text="Kullanıcı Ayarları"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Click="Close_Click"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Width="42"
                        Height="48"
                        ToolTip="Kapat"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <mi:MaterialIcon Kind="Close" Width="15" Height="15"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="28,24,28,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44"
                        CornerRadius="{DynamicResource RadiusLg}"
                        Background="{DynamicResource PrimaryLightBrush}"
                        Margin="0,0,14,0">
                    <mi:MaterialIcon Kind="AccountCogOutline"
                                     Width="22"
                                     Height="22"
                                     Foreground="{DynamicResource PrimaryBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Kullanıcı Ayarları"
                               Style="{StaticResource PageTitleStyle}"
                               FontSize="24"/>
                    <TextBlock Text="Giriş bilgileri, profil fotoğrafı ve avatar tercihi"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Padding="28,0,28,18"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource BentoCardStyle}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="112" Height="112" Margin="0,0,22,0">
                            <Ellipse Fill="{DynamicResource PrimaryLightBrush}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1"/>
                            <Image x:Name="AvatarImage"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed"
                                   SizeChanged="AvatarImage_SizeChanged"/>
                            <TextBlock x:Name="AvatarText"
                                       Text="EA"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Giriş ekranı avatarı"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Fotoğraf seçmezseniz hesap baş harfi kullanılır."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Fotoğraf Seç"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="SelectPhoto_Click"/>
                                <Button Content="Fotoğrafı Sil"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="RemovePhoto_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource BentoCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Profil bilgileri"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Ana ekranda ve giriş deneyiminde kullanılacak bilgileri düzenleyin."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,18"/>

                        <TextBlock Text="Kullanıcı adı" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="UsernameBox"
                                 MinHeight="44"
                                 Margin="0,0,0,14"
                                 TextChanged="UsernameBox_TextChanged"/>

                        <TextBlock Text="Cinsiyet" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="GenderUnspecifiedOption"
                                         Grid.Column="0"
                                         Content="Belirtmek istemiyorum"
                                         GroupName="GenderOptions"
                                         Style="{StaticResource GenderOptionStyle}"
                                         Checked="GenderOption_Checked"/>
                            <RadioButton x:Name="GenderFemaleOption"
                                         Grid.Column="1"
                                         Content="Kadın"
                                         GroupName="GenderOptions"
                                         Style="{StaticResource GenderOptionStyle}"
                                         Checked="GenderOption_Checked"/>
                            <RadioButton x:Name="GenderMaleOption"
                                         Grid.Column="2"
                                         Content="Erkek"
                                         GroupName="GenderOptions"
                                         Style="{StaticResource GenderOptionStyle}"
                                         Margin="0"
                                         Checked="GenderOption_Checked"/>
                        </Grid>

                        <TextBlock Text="Mevcut şifre" Style="{StaticResource LabelStyle}"/>
                        <PasswordBox x:Name="CurrentPasswordBox" MinHeight="44" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Yeni şifre" Style="{StaticResource LabelStyle}"/>
                                <PasswordBox x:Name="NewPasswordBox" MinHeight="44"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Yeni şifre tekrar" Style="{StaticResource LabelStyle}"/>
                                <PasswordBox x:Name="ConfirmPasswordBox" MinHeight="44"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="StatusBorder"
                                Style="{StaticResource AlertErrorStyle}"
                                Visibility="Collapsed"
                                Margin="0,16,0,0">
                            <TextBlock x:Name="StatusText" Style="{StaticResource AlertErrorTextStyle}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource TopBarBgBrush}"
                Padding="28,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Vazgeç"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="Kaydet"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
