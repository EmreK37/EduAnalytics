<Window x:Class="EduAnalytics.UI.Views.OmrGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optik Form Üretici" Height="900" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Padding="24" Background="{DynamicResource SurfaceBrush}">
            <StackPanel>
                <TextBlock Text="Optik Form Ayarları" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>

                <TextBlock Text="Kurum Adı" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="InstitutionTextBox" Text="Doğuş Üniversitesi" Margin="0,0,0,16" TextChanged="Setting_Changed"/>

                <TextBlock Text="Sınav Adı" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="ExamNameTextBox" Text="Vize Sınavı" Margin="0,0,0,24" TextChanged="Setting_Changed"/>

                <Border Background="{DynamicResource PageBgBrush}" Padding="16" CornerRadius="8" Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Text="Sistemden Gelen Sabit Değerler" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        
                        <TextBlock x:Name="QuestionCountText" Text="Soru Sayısı: -" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BookletText" Text="Kitapçık: -" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                        <TextBlock Text="Öğrenci No: 12 Hane (Sabit)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                        <TextBlock Text="Şık Sayısı: 5 Şık (A-E) (Sabit)" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Button Content="PDF Kaydet ve Çık" Style="{StaticResource PrimaryButtonStyle}" Height="44" Click="SavePdf_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

        <Border Grid.Column="2" Background="#E5E7EB" Padding="24">
            <Viewbox Stretch="Uniform">
                <Border Width="794" Height="1123" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Effect="{DynamicResource DropShadowEffect}">
                    <Canvas x:Name="PaperPreview"/>
                </Border>
            </Viewbox>
        </Border>
    </Grid>
</Window>
