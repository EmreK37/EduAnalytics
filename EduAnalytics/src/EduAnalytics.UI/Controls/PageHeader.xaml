<UserControl x:Class="EduAnalytics.UI.Controls.PageHeader"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             MinHeight="82"
             Margin="0,0,0,30">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Border Width="48"
                    Height="48"
                    CornerRadius="{DynamicResource RadiusXl}"
                    Background="{DynamicResource PrimaryLightBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    Effect="{DynamicResource ShadowSm}"
                    Margin="0,0,14,0">
                <mi:MaterialIcon Kind="{Binding Icon, ElementName=Root}"
                                 Width="23"
                                 Height="23"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           FontSize="32"
                           LineHeight="38"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextOptions.TextFormattingMode="Display"
                           Margin="0,0,0,1"/>
                <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                           Style="{StaticResource PageSubtitleStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="760"/>
            </StackPanel>
        </StackPanel>

        <ContentPresenter Grid.Column="1"
                          Content="{Binding Actions, ElementName=Root}"
                          VerticalAlignment="Center"
                          Margin="18,0,0,0"/>
    </Grid>
</UserControl>
