<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Görüntü işleme: hizalama (homografi) + OMR baloncuk okuma -->
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />

    <!-- PaddleOCR: ad-soyad / öğrenci no metin okuma (in-process, Python gerektirmez) -->
    <PackageReference Include="Sdcb.PaddleOCR" Version="2.7.0.3" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.Local" Version="2.7.0" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="2.5.0" />

    <!-- Taranmış PDF sayfalarını bitmap'e çevirme -->
    <PackageReference Include="PDFtoImage" Version="4.1.1" />

    <!-- Optik form PDF üretimi -->
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EduAnalytics.Core\EduAnalytics.Core.csproj" />
  </ItemGroup>

</Project>
